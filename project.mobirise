eft":"0","padding":"0.5rem 1rem","& when (@sticky)":{"position":"fixed"}},".nav-link":{"font-weight":"600 !important"},"a.nav-link":{"-webkit-justify-content":"center","justify-content":"center","display":"flex","-webkit-align-items":"center","align-items":"center"},".mbr-iconfont":{"font-size":"1.5rem","padding-right":"0.5rem"},".icons-menu":{"-webkit-flex-wrap":"wrap","flex-wrap":"wrap","display":"flex","-webkit-justify-content":"center","justify-content":"center","padding-left":"1rem","text-align":"center","span":{"font-size":"26px","color":"@primaryColor"}},"@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')":{".navbar":{"height":"77px","&.opened":{"height":"auto"}},".nav-item .nav-link:hover::before":{"width":"175%","max-width":"calc(100% ~'+' 2rem)","left":"-1rem"}}},"_name":"extMenu6","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"extMenu6 menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global always-top position-absolute once=\"menu\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Show Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.2\" value=\"2.8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Show Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Show Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\">\n        <select title=\"Icons\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Show Button(s)\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"color\" title=\"Hamburger Color\" name=\"hamburgerColor\" value=\"#57468b\">\n        <input type=\"color\" title=\"Background Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                    'navbar-expand-lg':!collapsed,\n                    'collapsed':collapsed}\">\n        <div class=\"navbar-brand\">\n            <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                <a href=\"https://mortgagekonsult.org\">\n                    <img src=\"@PROJECT_PATH@/assets/images/logo-89x40.png\" alt=\"Mortgage Konsult\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                </a>\n            </span>\n            <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\"><a class=\"navbar-caption text-primary\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">MobiRise\n                </a></span>\n        </div>\n        <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems\">\n            <div class=\"hamburger\">\n                <span></span>\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n            <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish&&!showBrand&&!showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"about-us.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">ABOUT US</a></li>\n                \n\n                <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"services.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">SERVICES</a></li>\n                <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"page5.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">GALLERY</a></li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"contact.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">CONTACT</a></li></ul>\n            <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons px-2 mbr-section-btn\"><a class=\"btn btn-sm btn-success-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-call-24h mbr-iconfont mbr-iconfont-btn\"></span>SALES REP</a></div>\n\n            <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                <a href=\"https://mobiri.se\" target=\"_blank\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-globe-2 mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-globe-2 mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-cash mobi-mbri\" style=\"color: rgb(242, 246, 255); fill: rgb(242, 246, 255);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 4\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"color: rgb(242, 246, 255); fill: rgb(242, 246, 255);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 5\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-alert mobi-mbri\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                </a>\n            </div>\n\n        </div>\n    </nav>\n</section>","_cid":"ueV5A3WvXO","_anchor":"extMenu6-1i","_protectedParams":[],"_global":true,"_once":"menu","_params":{}}]},"contact.html":{"settings":{"title":"Contact","meta_descr":"Get in touch! We would love to hear from you.","header_custom":"","footer_custom":"","html_before":"","order":4},"components":[{"_name":"contact1","_sourceTheme":"bistrom5","_customHTML":"<section data-bs-version=\"5\" class=\"contact1\" group=\"Contact\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    \n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"9\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n<!--         <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked> -->\n<!--         <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked> -->\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverse\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Phone\" name=\"showPhone\">\n        <input type=\"checkbox\" title=\"Address\" name=\"showAddress\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/bistrom5/components/_images/background.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    \n    \n        <div class=\"row justify-content-end align-items-center\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n                <div class=\"col-12 col-md-6 col-lg-6\">\n                    <div class=\"image-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-1807x1084.webp\" alt>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6 col-lg-6\">\n                    <div class=\"main_header text-center\">\n                        <div class=\"item-img\" mbr-if=\"showImage\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mbr-480x433.webp\" alt>\n                        </div>\n                        <div class=\"header_phone\" mbr-if=\"showPhone\">\n                            <h3 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">Contact Us:</h3>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-5\">\n                 \n                        <a href=\"tel:12345678900\" class=\"text-primary\">+1 234-567-8900</a>\n                                                      <br>\n                        <a href=\"tel:98765432100\" class=\"text-primary\">+9 876-543-2100</a></p>\n                        </div>\n                        <div class=\"header_address\" mbr-if=\"showAddress\">\n                            <h3 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">Contact Us:</h3>\n                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-5\">We would love to hear from you.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n    \n\n    \n</section>","_styles":{"padding-top":"(@paddingTop * 1rem)","padding-bottom":"(@paddingBottom * 1rem)","position":"relative","& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},".image-wrapper":{"position":"relative","width":"100%","img":{"display":"block","width":"100%","max-height":"100vh","object-fit":"cover"}},".item-img":{"margin-bottom":"18px","display":"block","text-align":"center","img":{"width":"240px","height":"auto","object-fit":"contain","display":"inline-block","transition":"transform 0.29s cubic-bezier(0.4, 0.12, 0.4, 0.85)"}},".main_header":{"padding":"10%","@media (min-width: 992px)":{"padding":"0 15%","&:hover img":{"transform":"translateX(7px)"}},"@media (max-width: 767px)":{"padding":"30px 12px 4rem"}},".mbr-section-title":{"margin-bottom":"22px","color":"#149dcc"},".mbr-text":{"margin":"11px 0 4px","color":"#202020"},".header_address":{"margin-top":"26px"}},"_cid":"uhJEPbvGdW","_anchor":"contact1-1n","_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"_name":"contacts05","_customHTML":"<section class=\"contact5\" group=\"Contact\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#0196e3\" selected condition=\"showIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1080.webp\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#f2f3f7\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#55b4d4\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 pb-5\" mbr-if=\"showMainTitle || showMainSubtitle\" mbr-class=\"{'col-lg-9': cardsAmount == '3'}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    <b>Contacts</b>\n                </h3>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-7\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\"><b>We are available 24/7 to hear from you</b></h5>\n            </div>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-md-6 col-lg-4\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <a href=\"mailto:info@mortgagekonsult.com\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\" style=\"color: rgb(247, 237, 74); fill: rgb(247, 237, 74);\"></span></a>\n                        </div>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>Email</b></h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">info@mortgagekonsult.com<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <a href=\"page4.html#contact2-12\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\" style=\"color: rgb(247, 237, 74); fill: rgb(247, 237, 74);\"></span></a>\n                        </div>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>Office</b></h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">3b Ribadu Road, Off Awolowo Road, Ikoyi, Lagos&nbsp;<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-box align-left\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <a href=\"tel:+234 802 238 6840\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"color: rgb(247, 237, 74); fill: rgb(247, 237, 74);\"></span></a>\n                        </div>\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>Phone</b></h5>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">+234 802 238 6840<br></p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>","_styles":{"padding-top":"(@paddingTop * 1rem)","padding-bottom":"(@paddingBottom * 1rem)","& when (@bg-type = \"color\")":{"background-color":"@bg-value"},"& when (@bg-type = \"image\")":{"background-image":"url(@bg-value)"},".mbr-iconfont":{"display":"block","font-size":"4rem","color":"@iconColor","margin-bottom":"1.5rem"},".col-lg-4, .col-12":{"padding":"0 2rem"},".row":{"margin":"0 -2rem","justify-content":"center"},".card-wrapper":{"padding":"3rem 2rem","box-shadow":"0.6em 0.6em 1.2em #d2dce9, -0.5em -0.5em 1em #ffffff","border-radius":"3rem","@media (max-width: 767px)":{"padding":"4rem 2rem"},"@media (max-width: 992px)":{"margin-bottom":"3rem"}},".card-title, .iconfont-wrapper":{"color":"#383232","text-align":"center"},".card-text":{"color":"#ffffff","text-align":"center"},".mbr-section-subtitle":{"color":"#ffffff"},".mbr-section-title":{"color":"#000000"}},"_cid":"sAN04q8oNc","_anchor":"contacts05-14","_sourceTheme":"mobirise4-blocks-theme","_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"_name":"contact2","_customHTML":"<section class=\"contact2\" group=\"Contact\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"3b Ribadu Road, Off Awolowo Road, Ikoyi, Lagos \" value=\"3b Ribadu Road, Off Awolowo Road, Ikoyi, Lagos \">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"google-map\" mbr-map=\"googleMap\">\n    </div>\n</section>","_styles":{".google-map":{"filter":"grayscale(0.9)","height":"34rem","position":"relative","iframe":{"height":"100%","width":"100%"},"[data-state-details]":{"color":"#6b6763","font-family":"Montserrat","height":"1.5em","margin-top":"-0.75em","padding-left":"1.25rem","padding-right":"1.25rem","position":"absolute","text-align":"center","top":"50%","width":"100%"},"&[data-state]":{"background":"#e9e5dc"},"&[data-state=\"loading\"]":{"[data-state-details]":{"display":"none"},"&::after":{}}}},"_cid":"sAMY4NRaFS","_anchor":"contact2-12","_sourceTheme":"mobirise4-blocks-theme","_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)",".mbr-overlay":{"background-color":"@overlayColor","opacity":"@overlayOpacity"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@customStyle)":{"input, textarea":{"border-left":"none","border-top":"none","border-right":"none","border-radius":"0","min-height":"3rem","padding":"0rem!important","font-size":"1rem","&:focus":{"border-left":"none","border-top":"none","border-right":"none"}},".form-control, .field-input":{"padding":"0.5rem","background-color":"@fieldColor","border-color":"@borderColor","color":"@formText","transition":"0.4s","box-shadow":"none","outline":"none","&:hover, &:focus":{"background-color":"@fieldHover","border-color":"@borderHover","color":"contrast(@formText, #000000, #ffffff, 30%)","box-shadow":"none","outline":"none"}},"input::-webkit-input-placeholder, textarea::-webkit-input-placeholder":{"color":"@formPlaceholder"},"input:-moz-placeholder, textarea:-moz-placeholder":{"color":"@formPlaceholder"},".jq-selectbox li, .jq-selectbox li":{"background-color":"@fieldColor","color":"contrast(@fieldColor, #000000, #ffffff, 30%)"},".jq-selectbox li:hover, .jq-selectbox li.selected":{"background-color":"@fieldHover","color":"contrast(@fieldHover, #000000, #ffffff, 30%)"},".jq-selectbox:hover .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldColor"},".jq-selectbox .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldHover"}},"img":{"width":"100%","height":"100%","object-fit":"cover"},".mbr-form":{"max-width":"450px"},"textarea":{"min-height":"150px"},".mbr-text":{"color":"#cccccc"},".mbr-form .btn":{"width":"100%","justify-content":"space-between",".mbr-iconfont":{"font-size":"1.5rem","order":"2"}}},"_name":"form001","_customHTML":"<section class=\"form\" group=\"Form\" plugins=\"formstyler\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n\n        <header>Style</header>\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#333333\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#333333\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#cccccc\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#cccccc\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#cccccc\" condition=\"customStyle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/assets/background.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#333333\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay && bg.type=='image')\"></div>\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div mbr-form class=\"col-lg-6 mx-auto py-5 mbr-form\">\n                <h2 class=\"mbr-section-title align-left pb-4 mbr-semibold mbr-white mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\">Connect with us</h2>\n                <p class=\"mbr-text mbr-black align-left pb-4 mbr-regular mbr-light mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">Please write us at any time you would have any kind of concern or question. We would enjoy to help you.</p>\n\n                <!---Formbuilder Form--->\n                <form action=\"info@mortgagekonsult.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n                    <div class=\"form-row\">\n                        <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out\n                            the form!</div>\n                        <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some\n                            problem!</div>\n                    </div>\n                    <div class=\"dragArea form-row\">\n                        <div class=\"col-lg-12 form-group\" data-for=\"first-name\">\n                            <input type=\"text\" name=\"first-name\" placeholder=\"First Name\" data-form-field=\"first-name\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div class=\"col-lg-12 form-group\" data-for=\"last-name\">\n                            <input type=\"text\" name=\"last-name\" placeholder=\"Last Name\" data-form-field=\"last-name\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div class=\"col-lg-12 form-group\" data-for=\"company\">\n                            <input type=\"text\" name=\"company\" placeholder=\"Company\" data-form-field=\"company\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div data-for=\"email\" class=\"col-lg-12 form-group\" style>\n                            <input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div data-for=\"phone\" class=\"col-lg-12 form-group\">\n                            <input type=\"tel\" name=\"phone\" placeholder=\"Phone\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" class=\"form-control\" pattern=\"*\" value>\n                        </div>\n                        <div data-for=\"message\" class=\"col-lg-12 form-group\">\n                            <textarea name=\"message\" placeholder=\"Message\" data-form-field=\"message\" mbr-theme-style=\"display-7\" class=\"form-control\" value></textarea>\n                        </div>\n                        <div class=\"col-lg-12 mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>WAY TO GO!</a></div>\n                    </div>\n                </form>\n                <!---Formbuilder Form--->\n            </div>\n\n            <div class=\"col-lg-6 img-col\">\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1777x1184.webp\" alt=\"Connect with us\" title>\n            </div>\n        </div>\n\n    </div>\n</section>","_cid":"sAMXxIC1gw","_anchor":"contacts","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"img":{"width":"40px","margin-right":"1rem"},".navbar-brand":{"display":"flex","align-items":"center"},"@media (max-width: 1200px)":{".row":{"margin":"0 2rem"}},".container":{"max-width":"1500px"},"& when (@customStyle)":{".form-control, .field-input":{"padding":"0.5rem","background-color":"@fieldColor","border-color":"@borderColor","color":"@formText","transition":"0.4s","box-shadow":"none","outline":"none","&:hover, &:focus":{"background-color":"@fieldHover","border-color":"@borderHover","color":"contrast(@formText, #000000, #ffffff, 30%)","box-shadow":"none","outline":"none"}},"input::-webkit-input-placeholder, textarea::-webkit-input-placeholder":{"color":"@formPlaceholder"},"input:-moz-placeholder, textarea:-moz-placeholder":{"color":"@formPlaceholder"},".jq-selectbox li, .jq-selectbox li":{"background-color":"@fieldColor","color":"contrast(@fieldColor, #000000, #ffffff, 30%)"},".jq-selectbox li:hover, .jq-selectbox li.selected":{"background-color":"@fieldHover","color":"contrast(@fieldHover, #000000, #ffffff, 30%)"},".jq-selectbox:hover .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldColor"},".jq-selectbox .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldHover"}},".btn":{"width":"80px!important","justify-content":"center","padding":"1rem 1rem!important","margin":"0!important","height":"100%",".mbr-iconfont":{"font-size":"1.2rem"}},"input":{"border-radius":"0","padding":"1rem!important","font-size":"1rem","height":"100%"},".col, .col-auto":{"padding":"0"},".form-group":{"margin-bottom":"0rem"},".items":{"color":"#333333"},".form-title":{"color":"#333333"},"@media (max-width: 992px)":{".col-md-6, .navbar-brand":{"margin-bottom":"2rem"}},"@media (max-width: 767px)":{".navbar-brand":{"justify-content":"center"},".row":{"margin":"0"}}},"_name":"footer003","_customHTML":"<section class=\"footer2\" group=\"Footers\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"range\" inline title=\"Col 1 Items\" name=\"items1\" min=\"0\" max=\"5\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Col 2 Items\" name=\"items2\" min=\"0\" max=\"5\" step=\"1\" value=\"2\">\n\n        <header>Form Style</header>\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#efeeee\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#efeeee\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#efeeee\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#efeeee\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#333333\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#767676\" condition=\"customStyle\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-4 col-md-12 align-left\">\n                <div class=\"navbar-brand\">\n                    <span class=\"navbar-logo\" mbr-if=\"showLogo\">\n                        <img src=\"@PROJECT_PATH@/assets/images/logo.png\" alt=\"Mobirise\">\n                    </span>\n                    <span mbr-text mbr-theme-style=\"display-5\" class=\"mbr-fonts-style mbr-semibold navbar-caption-wrap\" mbr-if=\"showTitle\">Mortgage Konsult</span>\n\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-2 col-md-6 align-left\" mbr-if=\"items1 > 0\">\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 0\" data-app-selector=\".items\">About Us</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 1\" data-app-selector=\".items\">Services</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 2\" data-app-selector=\".items\">Gallery</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 3\" data-app-selector=\".items\">Contact</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 4\" data-app-selector=\".items\">About Us</h5>\n            </div>\n\n            <div class=\"col-12 col-lg-2 col-md-6 align-left\" mbr-if=\"items2 > 0\">\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 0\" data-app-selector=\".items\">Contact</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 1\" data-app-selector=\".items\">Book a sales rep</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 2\" data-app-selector=\".items\">Economics</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 3\" data-app-selector=\".items\">Supply</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 4\" data-app-selector=\".items\">About Us</h5>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-12\">\n                <h5 class=\"mbr-fonts-style align-left form-title mbr-semibold pb-4\" mbr-theme-style=\"display-4\" data-app-selector=\".form-title\">Sign up for our Newsletter</h5>\n                <form action name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n                    <div class=\"form-row\">\n                        <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling\n                            out\n                            the form!</div>\n                        <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some\n                            problem!</div>\n                    </div>\n                    <div class=\"dragArea form-row\">\n                        <div class=\"col form-group\" data-for=\"email\">\n                            <input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n                        </div>\n                        <div class=\"col-auto\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                    </div>\n                </form>\n\n            </div>\n        </div>\n    </div>\n</section>","_cid":"sAMXxJeMSq","_anchor":"footer003-y","_sourceTheme":"mobirise4-blocks-theme","_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},".media-container-row .mbr-text":{"color":"#333333"}},"_name":"footer002","_customHTML":"<section class=\"footer2\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/_images/background5.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#efeeee\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mbr-regular mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2021 Mortgage Konsult -&nbsp;3b Ribadu Road, Off Awolowo Road, Ikoyi, Lagos - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>","_cid":"sAMXxKehIr","_anchor":"footer002-z","_sourceTheme":"mobirise4-blocks-theme","_protectedParams":[],"_global":true,"_once":"footers","_params":{}},{"alias":false,"_styles":{"height":"0 !important","