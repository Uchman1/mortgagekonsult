,"transition":"all 0.15s"},"&:nth-child(3)":{"top":"8px","transition":"all 0.15s"},"&:nth-child(4)":{"top":"16px","transition":"all 0.2s"}}},"nav.opened .hamburger span":{"&:nth-child(1)":{"top":"8px","width":"0","opacity":"0","right":"50%","transition":"all 0.2s"},"&:nth-child(2)":{"-webkit-transform":"rotate(45deg)","transform":"rotate(45deg)","transition":"all 0.25s"},"&:nth-child(3)":{"-webkit-transform":"rotate(-45deg)","transform":"rotate(-45deg)","transition":"all 0.25s"},"&:nth-child(4)":{"top":"8px","width":"0","opacity":"0","right":"50%","transition":"all 0.2s"}},".navbar-dropdown":{"position":"absolute","top":"0","left":"0","padding":"0.5rem 1rem","& when (@sticky)":{"position":"fixed"}},".nav-link":{"font-weight":"600 !important"},"a.nav-link":{"-webkit-justify-content":"center","justify-content":"center","display":"flex","-webkit-align-items":"center","align-items":"center"},".mbr-iconfont":{"font-size":"1.5rem","padding-right":"0.5rem"},".icons-menu":{"-webkit-flex-wrap":"wrap","flex-wrap":"wrap","display":"flex","-webkit-justify-content":"center","justify-content":"center","padding-left":"1rem","text-align":"center","span":{"font-size":"26px","color":"@primaryColor"}},"@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')":{".navbar":{"height":"77px","&.opened":{"height":"auto"}},".nav-item .nav-link:hover::before":{"width":"175%","max-width":"calc(100% ~'+' 2rem)","left":"-1rem"}}},"_name":"extMenu6","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"extMenu6 menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global always-top position-absolute once=\"menu\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Show Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.2\" value=\"2.8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Show Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Show Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\">\n        <select title=\"Icons\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Show Button(s)\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"color\" title=\"Hamburger Color\" name=\"hamburgerColor\" value=\"#57468b\">\n        <input type=\"color\" title=\"Background Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                    'navbar-expand-lg':!collapsed,\n                    'collapsed':collapsed}\">\n        <div class=\"navbar-brand\">\n            <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                <a href=\"https://mortgagekonsult.org\">\n                    <img src=\"@PROJECT_PATH@/assets/images/logo-89x40.png\" alt=\"Mortgage Konsult\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                </a>\n            </span>\n            <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\"><a class=\"navbar-caption text-primary\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">MobiRise\n                </a></span>\n        </div>\n        <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems\">\n            <div class=\"hamburger\">\n                <span></span>\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n            <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish&&!showBrand&&!showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"about-us.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">ABOUT US</a></li>\n                \n\n                <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"services.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">SERVICES</a></li>\n                <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"page5.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">GALLERY</a></li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"contact.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">CONTACT</a></li></ul>\n            <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons px-2 mbr-section-btn\"><a class=\"btn btn-sm btn-success-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-call-24h mbr-iconfont mbr-iconfont-btn\"></span>SALES REP</a></div>\n\n            <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                <a href=\"https://mobiri.se\" target=\"_blank\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-globe-2 mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-globe-2 mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-cash mobi-mbri\" style=\"color: rgb(242, 246, 255); fill: rgb(242, 246, 255);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 4\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"color: rgb(242, 246, 255); fill: rgb(242, 246, 255);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 5\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-alert mobi-mbri\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                </a>\n            </div>\n\n        </div>\n    </nav>\n</section>","_cid":"ueV5A3WvXO","_anchor":"extMenu6-1i","_protectedParams":[],"_global":true,"_once":"menu","_params":{}}]},"services.html":{"settings":{"title":"Services","meta_descr":"Our services include but are not limited to scheme design services, liquidity provision, enabling clients accessibility to attractive property equity loans and mortgages etc.","header_custom":"","footer_custom":"","html_before":"","order":2},"components":[{"_name":"header8","_customHTML":"<section class=\"header8\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\" plugins=\"mbr-animated-bg-text\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Show Arrow\" name=\"showArrow\" condition=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Animated Text\" name=\"showAnimatedText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/mbr-5-1920x1280.webp\" title=\"Background Image\" parallax selected>\n            <input type=\"color\" value=\"#66458e\" title=\"Background Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\" title=\"Background Video\">\n        </fieldset>\n        <input type=\"color\" title=\"Color 2\" name=\"bgColor2\" value=\"#ec6963\" condition=\"bg.type == 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <header codition=\"showSubtitle && showAnimatedText\">Animated Background Text</header>\n        <select title=\"Text Title\" name=\"textTitle\" condition=\"showAnimatedText\">\n            <option value=\"title1\">Title 1</option>\n            <option value=\"title2\">Title 2</option>\n            <option value=\"title3\">Title 3</option>\n            <option value=\"text\" selected>Text</option>\n            <option value=\"menu\">Menu</option>\n        </select>\n        <input type=\"color\" title=\"Text Color\" name=\"textColor\" value=\"#efefef\" condition=\"showAnimatedText\">\n        <input type=\"range\" inline title=\"Text Size\" name=\"textSize\" min=\"1\" max=\"20\" value=\"10\" step=\"1\" condition=\"showAnimatedText\">\n        <input type=\"range\" inline title=\"Text Opacity\" name=\"textOpacity\" min=\"0\" max=\"1\" value=\"0.2\" step=\"0.1\" condition=\"showAnimatedText\">\n        <input type=\"range\" inline title=\"Speed\" name=\"textSpeed\" min=\"50\" max=\"100\" value=\"60\" step=\"1\" condition=\"showAnimatedText\">\n        <input type=\"text\" title=\"Text\" inline name=\"animatedText\" value=\"Learn about our services.\" condition=\"showAnimatedText\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity,'background-color':overlayColor}\">\n    </div>\n\n    <div class=\"animated-text-background\" mbr-class=\"{'display-1': textTitle=='title1',\n                     'display-2': textTitle=='title2',\n                     'display-5': textTitle=='title3',\n                     'display-7': textTitle=='text',\n                     'display-4': textTitle=='menu'}\" mbr-style=\"{'color':textColor,\n                     'opacity': textOpacity,\n                     'font-size':textSize+'rem'}\" mbr-if=\"showAnimatedText\">\n        <span class=\"animated-element\" data-word=\"{{animatedText}}\" data-speed=\"{{textSpeed}}\">\n        </span>\n    </div>\n    <div class=\"container\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-md-6 align-left img-block\">\n                <div class=\"mbr-figure\">\n                    <img src=\"@PROJECT_PATH@/assets/images/mbr-1046x697.webp\" alt=\"Our service\" title>\n                </div>\n            </div>\n            <div class=\"mbr-white col-md-6\">\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style align-left pb-2\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle\"><b>LOREM ISPUM</b> DOLOR SIT AMET CONSECTETUR</h4>\n                <h1 class=\"mbr-section-title mbr-white mbr-bold mbr-fonts-style align-left\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                    Our Services</h1>\n                <p class=\"mbr-text pb-3 mbr-fonts-style mbr-white align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text,.mbr-section-btn\">\n                    Our services include but are not limited to scheme design services, liquidity provision, enabling clients accessibility to attractive property equity loans and mortgages etc.</p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" mbr-class=\"{'pt-3': !showText}\" data-toolbar=\"-mbrBtnMove\" mbr-if=\"showButtons\" class=\"mbr-section-btn\"><a class=\"btn btn-lg btn-primary\" type=\"submit\" data-app-placeholder=\"Type Text\" href=\"services.html#services\">Learn more</a></div>\n            </div>\n        </div>\n    </div>\n    <div mbr-if=\"showArrow && fullScreen\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>","_styles":{"overflow":"hidden !important","& when not (@fullScreen)":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)"},"& when (@bg-type = 'color')":{"background":"linear-gradient(to right, @bgColor2 0%, @bgColor2 30%, @bg-value 30%, @bg-value 100%)"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".animated-element":{"color":"@textColor"},".img-block":{"-webkit-align-self":"center","align-self":"center"},".mbr-section-subtitle":{"color":"#9c88bc"},"@media (min-width: 992px)":{".img-block":{"padding-right":"2rem"}},"@media (max-width: 767px)":{".mbr-figure":{"margin-top":"1rem"}},"@media (max-width: 768px)":{".img-block":{"padding-bottom":"2rem"},"& when (@bg-type = 'color')":{"background":"@bg-value"}}},"_cid":"sAMMWhkW1J","_anchor":"Services","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".container-fluid":{"padding":"0 3rem"},".underline":{".line":{"width":"5rem","height":"3px","background":"linear-gradient(to right, @primaryColor 50%, @secondaryColor 120%)","display":"inline-block"}},".panel-group":{"width":"100%","margin":"2rem auto","margin-top":"0"},".header-text":{"padding":"2rem 1rem !important"},".card":{"border-radius":"25px !important","background":"@accordionsColor","margin-bottom":"1rem","box-shadow":"0 7px 20px 0px rgba(0, 0, 0, 0.1)","-webkit-box-shadow":"0 7px 20px 0px rgba(0, 0, 0, 0.1)","-moz-box-shadow":"0 7px 20px 0px rgba(0, 0, 0, 0.1)","-o-box-shadow":"0 7px 20px 0px rgba(0, 0, 0, 0.1)","-ms-box-shadow":"0 7px 20px 0px rgba(0, 0, 0, 0.1)",".card-header":{"border-radius":"25px","border":"0px","padding":"0","background-color":"transparent !important","a.panel-title":{"transition":"all .3s","border-radius":"25px 25px 0 0","margin-bottom":"0","font-style":"normal","font-weight":"500","display":"flex","-webkit-align-items":"center","align-items":"center","text-decoration":"none !important","margin-top":"-1px","line-height":"normal","padding-right":"2rem","&:focus":{"text-decoration":"none !important"},"&:hover":{".sign":{"background-color":"@signHoverColor !important"}},".sign":{"position":"absolute","right":"0","top":"-1px","bottom":"0","border-radius":"0 25px 25px 0","background-color":"@signColor","padding":"2rem","padding-top":"36px","color":"contrast(@signColor)"},"h4":{"padding":"1rem 1rem","margin-bottom":"0"}},"a.collapsed":{"border-radius":"25px"}},".panel-body":{"width":"calc(~'100% - 80px')","border-radius":"0 0 0 25px"}},"@media (max-width: 767px)":{".container-fluid":{"padding":"0 1rem"},".header-text":{"padding":"1rem !important"},".sign":{"padding":"16px !important","padding-top":"22px !important"},".panel-body":{"width":"calc(~'100% - 48px')"},".panel-group":{"padding":"0"}},".header-text, .sign":{"color":"#232323"},".panel-text":{"color":"#0f7699"}},"_name":"extAccordion8","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"accordion1\" group=\"Accordion & Toggles & Tabs\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Underline\" name=\"showUnderline\" checked condition=\"showTitle\">\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n        <select title=\"Accordions Count\" name=\"bootstrapAccordion\">\n             <option value=\"1\">1</option>\n             <option value=\"2\">2</option>\n             <option value=\"3\">3</option>\n             <option value=\"4\" selected>4</option>\n             <option value=\"5\">5</option>\n             <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" title=\"Sign Color\" name=\"signColor\" value=\"#4f80e0\">\n        <input type=\"color\" title=\"Sign Hover Color\" name=\"signHoverColor\" value=\"#2461d8\">\n        <input type=\"color\" title=\"Accordions Color\" name=\"accordionsColor\" value=\"#ffffff\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=kI1YE_qenSU\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container-fluid\">\n        <div class=\"media-container-row align-center\">\n            <div class=\"col-12 col-md-12\">\n                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .underline\">VIEW SERVICES</h2>\n                <div class=\"underline align-center pb-3\" mbr-if=\"showUnderline && showTitle\">\n                    <div class=\"line\"></div>\n                </div>\n                <h3 class=\"mbr-section-subtitle mbr-light mbr-fonts-style pb-5\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-class=\"{'pt-3':!showUnderline}\">\n                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Saepe alias nam architecto iure, sapiente accusantium expedita maxime beatae deserunt ducimus fugit pariatur, cum molestias provident, vitae dolorum consequuntur, officiis soluta!\n                </h3>\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion col-sm-12 col-md-10 col-lg-8 align-left\" role=\"tablist\" aria-multiselectable=\"true\" mbr-class=\"{'pt-5':!showSubtitle}\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"collapsed panel-title\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>\n                                <h4 class=\"mbr-fonts-style header-text\" mbr-theme-style=\"display-5\" data-app-selector=\".header-text, .sign\">PMBs &amp; Other Financial Institutions</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body p-4\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">a)\t<b>SCHEME DESIGN SERVICES</b><br><b><br></b>Besides prospecting land and residual population with regards to range of income and development possibilities, we are armed with emerging or new city development proficiencies in addition to extensive financial synergies and collaborations which we bring to bear in the design of customiZed mortgage and investment schemes.<br>  \n<br>b)\t<b>PRIMARY AND SECONDARY MARKET INTERMEDIATION SERVICES\n</b><br>         In a bid to PROVIDE LIQUIDITY in the mortgage market we offer                      .        the Secondary Mortgage Organizations and other relevant                       .        Organizations attractive Mortgage Bond and Mortgage Backed                               .        Securities Packaging, Facilitation and Issuing Services.<br>\n<br>c)\t<b>ACTUARIAL SERVICES</b><br>We render Actuarial Appraisal, Data Collection and Intermediation Services in MORTGAGE PORTFOLIOS, INSURANCE, RE-INSURANCE, PENSIONS and EMPLOYEES BENEFITS. Also run assessment of Cross Selling Industry Services and Earnings Risk as it affects Mortgage Portfolios, Securities and Insurance.<br>\n<br>d)\t <b>RATING SERVICES</b><br>Conduct rating Services in Real Estate, Mortgages, Mortgage Backed Securities and Real Estate Investment Schemes.<br>\n<br>e)\t <b>TRAINING &amp; PUBLIC ENLIGHTENMENT SERVICES</b><br>Conduct Public Enlightenment, Seminars, Research, Workshop on Real Estate Development, Mortgages, Mortgage Backed Securities and Real Estates Investments.<br>\n<br>f)\t<b>EXCHANGE RATE STABILIZATION SERVICES</b><br>&nbsp;We devise Exchange Rate Stabilization Quantities, Bonds and Housing Scheme Packages.&nbsp; &nbsp;&nbsp;<br></p>\n                            </div>\n                        </div>\n                    </div>\n            \n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>\n                                <h4 class=\"mbr-fonts-style header-text\" mbr-theme-style=\"display-5\" data-app-selector=\".header-text, .sign\">To Individual Clients</h4>\n                            </a>\n                            \n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body p-4\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">a)\tWe Enable Clients Accessibility To Attractive Property Equity Loans and Mortgages\n<br>b)\tWe Provide Services That Enable Clients (Especially Employees) Alternative Sources Of Earnings Other Than Salaries And We Issue Income Stabilization Guarantees to PMBs Where Necessary.\n<br>c)\tAdvice And Manage Property Investment Portfolio Of Clients Including Outright Acquisition Of Property. \n<br>d)\tWe Administer Endowment And Other Investment Related Mortgages. \n<br>e)\tOther Mortgage Consultancy Services.&nbsp;&nbsp;<br></p>\n                            </div>\n                        </div>\n                    </div>\n            \n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed panel-title\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>\n                                <h4 class=\"mbr-fonts-style header-text\" mbr-theme-style=\"display-5\" data-app-selector=\".header-text, .sign\">To Real Estate &amp; Autonomous City Developers</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body p-4\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">a)\tWe Facilitate The Financing And Easy Marketability Of Real Estate Development (Registered With Our Organization) Through The Design Of Affordable Acquisition Plan Or Mortgage Scheme/Program For Prospective Corporate Or Individual Up-Takers.\n<br>b)\tWe Develop And Manage Real Estate Related Investment Scheme/ Products.\n<br>c)\t We Are Experts In Turn-Key Real Estate Development.\n<br>d)\tWe Have Expertise In Sustainable City Planning, Financing, Development And Marketing.\n<br>e)\tOff Shore Funding Utility.\n<br>f)\tWe Prepare Feasibility Reports, Conduct Economic Impact Assessments, Research And Appraisals In Diverse Real Estate Fields.\n<br>g)\tWe Have Expertise In Project Management And Supervision Of Real Estate Development.\n<br>h)\tBuilding Technologies Training &amp; Consultancy&nbsp;<br></p>\n                            </div>\n                        </div>\n                    </div>\n            \n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>\n                                <h4 class=\"mbr-fonts-style header-text\" mbr-theme-style=\"display-5\" data-app-selector=\".header-text, .sign\">To Housing Cooperatives</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body p-4\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">a)\tWe Provide Advisory Services In The Setting Up And Successful, Administration Of Housing Cooperatives.\n<br>b)\tWe Are Experts In Turn-Key Real Estate Development\n<br>c)\tLand Attorney, Assets Securitization.\n<br>d)\tMortgage Refinance And Repurchase Services. . Develop and Manage Investment Schemes for Housing Cooperatives.<br></p>\n                            </div>\n                        </div>\n                    </div>\n            \n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>\n                                <h4 class=\"mbr-fonts-style header-text\" mbr-theme-style=\"display-5\" data-app-selector=\".header-text, .sign\">\n                                    Returns &amp; Refunds\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body p-4\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                   Lorem ipsum dolor sit amet, consectetur adipisicing elit. Cupiditate, dolorem, non. Sunt aliquam a odio, sapiente corporis necessitatibus quia assumenda expedita tempora error non deserunt beatae ex, eaque voluptatem quas.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n            \n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>\n                                <h4 class=\"mbr-fonts-style header-text\" mbr-theme-style=\"display-5\" data-app-selector=\".header-text, .sign\">\n                                     Returns &amp; Refunds\n                                </h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body p-4\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                   Lorem ipsum dolor sit amet, consectetur adipisicing elit. Iusto voluptates dolorem, odit enim! Aspernatur quos ipsa, sit! Repudiandae, laboriosam enim aliquam, similique suscipit quas dicta voluptate repellendus distinctio laborum at!\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>","_cid":"sAMUQ81kvc","_anchor":"services","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)",".mbr-overlay":{"background-color":"@overlayColor","opacity":"@overlayOpacity"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@customStyle)":{"input, textarea":{"border-left":"none","border-top":"none","border-right":"none","border-radius":"0","min-height":"3rem","padding":"0rem!important","font-size":"1rem","&:focus":{"border-left":"none","border-top":"none","border-right":"none"}},".form-control, .field-input":{"padding":"0.5rem","background-color":"@fieldColor","border-color":"@borderColor","color":"@formText","transition":"0.4s","box-shadow":"none","outline":"none","&:hover, &:focus":{"background-color":"@fieldHover","border-color":"@borderHover","color":"contrast(@formText, #000000, #ffffff, 30%)","box-shadow":"none","outline":"none"}},"input::-webkit-input-placeholder, textarea::-webkit-input-placeholder":{"color":"@formPlaceholder"},"input:-moz-placeholder, textarea:-moz-placeholder":{"color":"@formPlaceholder"},".jq-selectbox li, .jq-selectbox li":{"background-color":"@fieldColor","color":"contrast(@fieldColor, #000000, #ffffff, 30%)"},".jq-selectbox li:hover, .jq-selectbox li.selected":{"background-color":"@fieldHover","color":"contrast(@fieldHover, #000000, #ffffff, 30%)"},".jq-selectbox:hover .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldColor"},".jq-selectbox .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldHover"}},"img":{"width":"100%","height":"100%","object-fit":"cover"},".mbr-form":{"max-width":"450px"},"textarea":{"min-height":"150px"},".mbr-text":{"color":"#cccccc"},".mbr-form .btn":{"width":"100%","justify-content":"space-between",".mbr-iconfont":{"font-size":"1.5rem","order":"2"}}},"_name":"form001","_customHTML":"<section class=\"form\" group=\"Form\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked=\"\">\n\n        <header>Style</header>\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked=\"\">\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#333333\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#333333\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#cccccc\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#cccccc\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#cccccc\" condition=\"customStyle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/assets/background.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#333333\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"true\"></mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay &amp;&amp; bg.type=='image')\"></div>\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div mbr-form=\"\" class=\"col-lg-6 mx-auto py-5 mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"info@mortgagekonsult.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-rcpha=\"true\" data-rcpha_sitekey=\"6Ld_rAkqAAAAAABljj3a362nD_JPHvyxemrq9eT0\" data-rcpha_secretkey=\"6Ld_rAkqAAAAAMM5eTK66xqhVNFjgrGJpUZyUCGp\" data-rcpha_label=\"true\">\n<div class=\"form-row\">\n<div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\">Thanks for filling out the form!</div>\n<div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\">Oops...! some problem!</div>\n</div>\n<div class=\"dragArea form-row\">\n<div class=\"col-lg-12\">\n<h2 mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" class=\"mbr-section-title align-left pb-4 mbr-semibold mbr-white mbr-fonts-style\">Connect with us</h2>\n</div>\n<div class=\"col-lg-12\">\n<p mbr-theme-style=\"display-4\" mbr-if=\"showText\" class=\"mbr-text mbr-black align-left pb-4 mbr-regular mbr-light mbr-fonts-style\">Please write us at any time you would have any kind of concern or question. We would enjoy to help you.</p>\n</div>\n<div data-for=\"first-name\" class=\"col-lg-12 form-group\">\n<input type=\"text\" name=\"first-name\" placeholder=\"First Name\" data-form-field=\"first-name\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"last-name\" class=\"col-lg-12 form-group\">\n<input type=\"text\" name=\"last-name\" placeholder=\"Last Name\" data-form-field=\"last-name\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"company\" class=\"col-lg-12 form-group\">\n<input type=\"text\" name=\"company\" placeholder=\"Company\" data-form-field=\"company\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"email\" class=\"col-lg-12 form-group\">\n<input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div class=\"col-lg-12 form-group\" data-for=\"phone\">\n<input type=\"tel\" name=\"phone\" placeholder=\"Phone\" pattern=\"*\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"message\" class=\"col-lg-12 form-group\">\n<textarea name=\"message\" placeholder=\"Message\" data-form-field=\"message\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n<div mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-lg-12 mbr-section-btn\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 btn btn-primary\">WAY TO GO!</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n\n            <div class=\"col-lg-6 img-col\">\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1777x1184.webp\" alt=\"Connect with us\" title=\"\">\n            </div>\n        </div>\n\n    </div>\n</section>","_cid":"sAMLoeclKq","_a