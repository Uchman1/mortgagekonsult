&:hover":{"opacity":"0.9"},"&::after, &::before":{"content":"none"}},"&.ie-fix":{"left":"50%","display":"block","width":"60%","margin-left":"-30%","text-align":"center"},"@media (max-width: 768px)":{"display":"none !important"}},"H5":{"color":"#e9ddd8"},".mbr-section-subtitle":{"color":"#ebc6b8"},"P":{"color":"#ffffff"}},"_cid":"sAN6PP4IpZ","_anchor":"Gallery","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".mbr-section-title":{"letter-spacing":"0.1em","color":"#232323","margin-bottom":"2rem"},".mbr-section-subtitle":{"color":"#232323","margin-bottom":"2rem","letter-spacing":"0.03em"},".list-img":{"width":"100px"},".ico2":{"color":"@icocolor","font-size":"~\"@{icon1}rem\""},".btn":{"margin":"0px !important"},".text-box":{"padding":"1rem","p":{"margin":"0"}},".ico-box":{"display":"flex","-webkit-align-items":"center","align-items":"center","padding":"0px","p":{"margin":"0"}},".second-col":{"display":"flex","-webkit-align-items":"center","align-items":"center","-webkit-justify-content":"center","justify-content":"center"},".carousel-item":{"-webkit-justify-content":"center","justify-content":"center",".media-container-row":{"-webkit-flex-grow":"1","flex-grow":"1"},".wrap-img":{"text-align":"center","background-position":"50% 50%","background-repeat":"no-repeat","background-size":"cover","max-width":"100%","width":"auto","height":"500px"}},".carousel":{"display":"flex","-webkit-flex-direction":"column-reverse","flex-direction":"column-reverse","width":"100%"},".carousel-indicators":{"display":"block","position":"relative","margin-top":"1rem","margin-right":"0","margin-left":"0","text-align":"center","li":{"display":"inline-block"}},".carousel-indicators li":{"max-width":"15%","max-height":"120px","width":"15%","height":"120px","border-radius":"0","opacity":"1","background-size":"cover","border":"none"},".carousel-indicators li.active":{"border":"0px"},".li1, .carousel-item:nth-child(1) .wrap-img":{"background-image":"url(@li1)"},".li2, .carousel-item:nth-child(2) .wrap-img":{"background-image":"url(@li2)"},".li3, .carousel-item:nth-child(3) .wrap-img":{"background-image":"url(@li3)"},".li4, .carousel-item:nth-child(4) .wrap-img":{"background-image":"url(@li4)"},".li5, .carousel-item:nth-child(5) .wrap-img":{"background-image":"url(@li5)"},".li6, .carousel-item:nth-child(6) .wrap-img":{"background-image":"url(@li6)"},"@media (max-width: 992px)":{".carousel-indicators li":{"max-width":"30%","max-height":"120px","width":"30%","height":"120px"}},"@media (max-width: 576px)":{".carousel-indicators li":{"max-width":"30%","max-height":"80px","width":"30%","height":"80px"}},".card-title2":{"color":"#149dcc"},".sq":{"color":"#767676"},".item":{"color":"#767676"}},"_name":"extGallery6","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"extGallery testimonials-slider\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n\n        <input type=\"range\" inline title=\"Items\" name=\"slidesCount\" min=\"1\" max=\"6\" step=\"1\" value=\"6\">\n        <input type=\"image\" title=\"Slide 1\" name=\"li1\" value=\"@PROJECT_PATH@/assets/images/download-1-259x194.webp\" condition=\"slidesCount > 0\">\n        <input type=\"image\" title=\"Slide 2\" name=\"li2\" value=\"@PROJECT_PATH@/assets/images/images-5-259x172.webp\" condition=\"slidesCount > 1\">\n        <input type=\"image\" title=\"Slide 3\" name=\"li3\" value=\"@PROJECT_PATH@/assets/images/images-6-259x173.webp\" condition=\"slidesCount > 2\">\n        <input type=\"image\" title=\"Slide 4\" name=\"li4\" value=\"../_images/img/05.jpg\" condition=\"slidesCount > 3\">\n        <input type=\"image\" title=\"Slide 5\" name=\"li5\" value=\"../_images/img/06.jpg\" condition=\"slidesCount > 4\">\n        <input type=\"image\" title=\"Slide 6\" name=\"li6\" value=\"../_images/img/08.jpg\" condition=\"slidesCount > 5\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"5000\" condition=\"showAutoplay\">\n\n        <header>Show/Hide</header>\n\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Colors</header>\n        <input type=\"color\" title=\"Icon\" value=\"#767676\" name=\"icocolor\" selected>\n\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Icon\" name=\"icon1\" min=\"0.2\" max=\"2\" step=\"0.1\" value=\"1.2\">\n\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"../_images/background1.jpg\" title=\"Image\">\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\" selected>\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=x9vz-axHndk\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"main container\">\n\n        <div class=\"row justify-content-center\">\n\n\n            <div class=\"second-col col-md-10\">\n                <div class=\"carousel slide slides\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n                    <ol class=\"carousel-indicators\">\n                        <li class=\"li1\" data-slide-to=\"0\"></li>\n                        <li class=\"li2\" mbr-if=\"slidesCount > 1\" data-slide-to=\"1\"></li>\n                        <li class=\"li3\" mbr-if=\"slidesCount > 2\" data-slide-to=\"2\"></li>\n                        <li class=\"li4\" mbr-if=\"slidesCount > 3\" data-slide-to=\"3\"></li>\n                        <li class=\"li5\" mbr-if=\"slidesCount > 4\" data-slide-to=\"4\"></li>\n                        <li class=\"li6\" mbr-if=\"slidesCount > 5\" data-slide-to=\"5\"></li>\n                    </ol>\n                    <div class=\"carousel-inner\" mbr-list mbr-list-grow=\"slidesCount\" data-visible=\"{{visibleSlides}}\">\n\n                        <div class=\"carousel-item \">\n                            <div class=\"media-container-row\">\n                                <div class=\"col-md-12\">\n\n                                    <div class=\"row justify-content-center\">\n                                        <div class=\"col-md-6\">\n                                            <div class=\"text-box align-left\">\n                                                <h4 class=\"card-title1 mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title1\">Summer Apartment</h4>\n                                                <div class=\"ico-box\" mbr-if=\"showText\">\n                                                    <span mbr-icon class=\"pr-2 mbr-iconfont mbr-iconfont-social ico2 mbri-pin\"></span>\n                                                    <p class=\"mbr-text mbr-fonts-style item mbr-normal\" mbr-theme-style=\"display-7\" data-app-selector=\".item\">New York, &nbsp;Willis Avenue</p>\n                                                </div>\n                                            </div>\n                                        </div>\n                                        <div class=\"col-md-6\">\n                                            <div class=\"text-box align-right\">\n                                                <h4 class=\"card-title2 mbr-fonts-style mbr-normal\" mbr-if=\"showTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title2\">$420.000</h4>\n                                                <p class=\"mbr-text mbr-fonts-style sq mbr-normal\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".sq\">$777 / sq m</p>\n                                            </div>\n                                        </div>\n                                    </div>\n\n                                    <div class=\"wrap-img \">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"carousel-item \">\n                            <div class=\"media-container-row\">\n                                <div class=\"col-md-12\">\n\n                                    <div class=\"row justify-content-center\">\n                                        <div class=\"col-md-6\">\n                                            <div class=\"text-box align-left\">\n                                                <h4 class=\"card-title1 mbr-fonts-style mbr-normal\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title1\">Hi-Tech Apartment&nbsp;</h4>\n                                                <div class=\"ico-box\" mbr-if=\"showText\">\n                                                    <span mbr-icon class=\"pr-2 mbr-iconfont mbr-iconfont-social ico2 mbri-pin\"></span>\n                                                    <p class=\"mbr-text mbr-fonts-style item mbr-normal\" mbr-theme-style=\"display-7\" data-app-selector=\".item\">Las Vegas, 32 Street</p>\n                                                </div>\n                                            </div>\n                                        </div>\n                                        <div class=\"col-md-6\">\n                                            <div class=\"text-box align-right\">\n                                                <h4 class=\"card-title2 mbr-fonts-style mbr-normal\" mbr-if=\"showTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title2\">$540.000</h4>\n                                                <p class=\"mbr-text mbr-fonts-style sq mbr-normal\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".sq\">$835 / sq m</p>\n                                            </div>\n                                        </div>\n                                    </div>\n\n                                    <div class=\"wrap-img \">\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"carousel-item \">\n                            <div class=\"media-container-row\">\n                                <div class=\"col-md-12\">\n\n                                    <div cl