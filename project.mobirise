lex-basis":"auto","flex-basis":"auto"},".icons-menu":{"padding-left":"0","padding-top":"0.5rem","padding-bottom":"0.5rem"}},"&.navbar-short":{"background":"@menuBgColor !important","min-height":"60px",".navbar-logo":{"img":{"height":"3rem !important","width":"auto"}},".navbar-brand":{"padding":"0"}}},".section":{"position":"relative","overflow":"visible !important"},".dropdown-item":{"font-weight":"400 !important","color":"black !important","&:hover":{"color":"black !important"}},".dropdown-menu":{"background-color":"white !important"},".navbar .dropdown.open > .dropdown-menu":{"border-radius":"10px","box-shadow":"0 10px 55px 5px fade(lighten(@secondaryColor, 10%), 35%)","display":"block"},".nav-link:before":{"content":"''","position":"absolute","left":"10px","top":"50%","width":"6px","height":"6px","border-radius":"50%","opacity":"0","background-color":"@secondaryColor","transform":"translateY(-50%)","transition":"all 0.3s"},".nav-item":{"&:hover":{".nav-link:before":{"opacity":"1 !important"}}},"@media (min-width: 992px)":{".nav-item":{"position":"relative"}},".dropdown .dropdown-menu .dropdown-item":{"width":"auto","-webkit-transition":"all 0.25s ease-in-out","-moz-transition":"all 0.25s ease-in-out","transition":"all 0.25s ease-in-out","&::after":{"right":"0.5rem"},"&:hover":{"padding-left":"2rem","padding-right":"1rem"},".mbr-iconfont":{"margin-left":"-1.8rem","padding-right":"1rem","font-size":"inherit","&:before":{"display":"inline-block","-webkit-transform":"scale(1, 1)","transform":"scale(1, 1)","-webkit-transition":"all 0.25s ease-in-out","-moz-transition":"all 0.25s ease-in-out","transition":"all 0.25s ease-in-out"}}},".collapsed":{"flex-direction":"row !important",".dropdown-menu .dropdown-item:before":{"display":"none"},".dropdown .dropdown-menu .dropdown-item":{"padding":"0.235em 1.5em 0.235em 1.5em !important","transition":"none","margin":"0 !important"}},".navbar-caption":{"font-weight":"600 !important"},".navbar-brand":{"-webkit-flex-shrink":"0","flex-shrink":"0","-webkit-align-items":"center","align-items":"center","margin-right":"0","padding":"0","transition":"all 0.3s","word-break":"break-word","z-index":"1",".navbar-caption":{"line-height":"inherit !important"},".navbar-logo a":{"outline":"none","img":{"width":"auto"}}},".dropdown-item.active, .dropdown-item:active":{"background-color":"transparent"},".navbar-expand-lg .navbar-nav .nav-link":{"padding":"0"},".nav-dropdown .link.dropdown-toggle":{"margin-right":"1.667em","&[aria-expanded='true']":{"margin-right":"0","padding":"0.667em 1.667em"}},".navbar.navbar-expand-lg .dropdown":{".dropdown-menu":{"background":"@menuBgColor",".dropdown-submenu":{"margin":"0","left":"100%"}}},"ul.navbar-nav":{"-webkit-flex-wrap":"wrap","flex-wrap":"wrap"},".navbar-buttons when (@showButtons)":{"flex-wrap":"wrap","text-align":"center"},"button.navbar-toggler":{"outline":"none","width":"31px","height":"20px","cursor":"pointer","transition":"all 0.2s","position":"relative","-webkit-align-self":"center","align-self":"center",".hamburger span":{"position":"absolute","right":"0","width":"30px","height":"2px","border-right":"5px","background-color":"@hamburgerColor","&:nth-child(1)":{"top":"0","transition":"all 0.2s"},"&:nth-child(2)":{"top":"8px","transition":"all 0.15s"},"&:nth-child(3)":{"top":"8px","transition":"all 0.15s"},"&:nth-child(4)":{"top":"16px","transition":"all 0.2s"}}},"nav.opened .hamburger span":{"&:nth-child(1)":{"top":"8px","width":"0","opacity":"0","right":"50%","transition":"all 0.2s"},"&:nth-child(2)":{"-webkit-transform":"rotate(45deg)","transform":"rotate(45deg)","transition":"all 0.25s"},"&:nth-child(3)":{"-webkit-transform":"rotate(-45deg)","transform":"rotate(-45deg)","transition":"all 0.25s"},"&:nth-child(4)":{"top":"8px","width":"0","opacity":"0","right":"50%","transition":"all 0.2s"}},".navbar-dropdown":{"position":"absolute","top":"0","left":"0","padding":"0.5rem 1rem","& when (@sticky)":{"position":"fixed"}},".nav-link":{"font-weight":"600 !important"},"a.nav-link":{"-webkit-justify-content":"center","justify-content":"center","display":"flex","-webkit-align-items":"center","align-items":"center"},".mbr-iconfont":{"font-size":"1.5rem","padding-right":"0.5rem"},".icons-menu":{"-webkit-flex-wrap":"wrap","flex-wrap":"wrap","display":"flex","-webkit-justify-content":"center","justify-content":"center","padding-left":"1rem","text-align":"center","span":{"font-size":"26px","color":"@primaryColor"}},"@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')":{".navbar":{"height":"77px","&.opened":{"height":"auto"}},".nav-item .nav-link:hover::before":{"width":"175%","max-width":"calc(100% ~'+' 2rem)","left":"-1rem"}}},"_name":"extMenu6","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"extMenu6 menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" global always-top position-absolute once=\"menu\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Show Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.2\" value=\"2.8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Show Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Show Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\">\n        <select title=\"Icons\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Show Button(s)\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"color\" title=\"Hamburger Color\" name=\"hamburgerColor\" value=\"#57468b\">\n        <input type=\"color\" title=\"Background Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                    'navbar-expand-lg':!collapsed,\n                    'collapsed':collapsed}\">\n        <div class=\"navbar-brand\">\n            <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                <a href=\"https://mortgagekonsult.org\">\n                    <img src=\"@PROJECT_PATH@/assets/images/logo-89x40.png\" alt=\"Mortgage Konsult\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                </a>\n            </span>\n            <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\"><a class=\"navbar-caption text-primary\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">MobiRise\n                </a></span>\n        </div>\n        <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems\">\n            <div class=\"hamburger\">\n                <span></span>\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n            <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish&&!showBrand&&!showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"about-us.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">ABOUT US</a></li>\n                \n\n                <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"services.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">SERVICES</a></li>\n                <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"page5.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">GALLERY</a></li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"contact.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">CONTACT</a></li></ul>\n            <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons px-2 mbr-section-btn\"><a class=\"btn btn-sm btn-success-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v1-call-24h mbr-iconfont mbr-iconfont-btn\"></span>SALES REP</a></div>\n\n            <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                <a href=\"https://mobiri.se\" target=\"_blank\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-globe-2 mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-globe-2 mobi-mbri\" style=\"color: rgb(87, 70, 139); fill: rgb(87, 70, 139);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-cash mobi-mbri\" style=\"color: rgb(242, 246, 255); fill: rgb(242, 246, 255);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 4\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"color: rgb(242, 246, 255); fill: rgb(242, 246, 255);\"></span>\n                </a>\n                <a href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 5\">\n                    <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-alert mobi-mbri\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                </a>\n            </div>\n\n        </div>\n    </nav>\n</section>","_cid":"ueV5A3WvXO","_anchor":"extMenu6-1i","_protectedParams":[],"_global":true,"_once":"menu","_params":{}},{"alias":false,"_styles":{"& when not (@fullScreen)":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".mbr-text,.typed-text,.mbr-section-text":{"letter-spacing":"0.03rem"},".btn":{"margin-left":"4px !important"},".animated-element":{"color":"@wordsColor"},".typed-cursor":{"opacity":"1","-webkit-animation":"blink 0.7s infinite","-moz-animation":"blink 0.7s infinite","animation":"blink 0.7s infinite","color":"@wordsColor"},"@keyframes blink":{"0%":{"opacity":"1"},"50%":{"opacity":"0"},"100%":{"opacity":"1"}},"@-webkit-keyframes blink":{"0%":{"opacity":"1"},"50%":{"opacity":"0"},"100%":{"opacity":"1"}},"@-moz-keyframes blink":{"0%":{"opacity":"1"},"50%":{"opacity":"0"},"100%":{"opacity":"1"}}},"_name":"extHeader5","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"header2\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" plugins=\"Typed\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Show Arrow\" name=\"showArrow\" condition=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Animated Text\" name=\"showAnimatedText\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1082.webp\" title=\"Background Image\" selected parallax>\n            <input type=\"color\" value=\"#232323\" title=\"Background Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=l8UXhtqV6hU\" title=\"Background Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#787324\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <header codition=\"showSubtitle && showAnimatedText\">Animated Text Settings</header>\n        <select title=\"Words Title\" name=\"wordsTitle\" condition=\"showSubtitle && showAnimatedText\">\n            <option value=\"title1\" selected>Title 1</option>\n            <option value=\"title2\">Title 2</option>\n            <option value=\"title3\">Title 3</option>\n            <option value=\"text\">Text</option>\n            <option value=\"menu\">Menu</option>\n        </select>\n        <input type=\"color\" title=\"Words Color\" name=\"wordsColor\" value=\"#55b4d4\" condition=\"showSubtitle && showAnimatedText\">\n        <input type=\"range\" inline title=\"Type Speed\" name=\"typeSpeed\" min=\"1\" max=\"100\" value=\"50\" step=\"1\" condition=\"showSubtitle && showAnimatedText\">\n        <input type=\"text\" title=\"Word 1\" inline name=\"animatedWord1\" value=\"Are Resolving Chronic Socioeconomic Challenges\" condition=\"showSubtitle && showAnimatedText\">\n        <input type=\"text\" title=\"Word 2\" inline name=\"animatedWord2\" value=\"Create and Tailor Financial Concepts and Models&nbsp;TO&nbsp;FIT\" condition=\"showSubtitle && showAnimatedText\">\n        <input type=\"text\" title=\"Word 3\" inline name=\"animatedWord3\" value=\"Provide Affordable National Mortgage Solutions.\" condition=\"showSubtitle && showAnimatedText\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"mbr-white col-md-12\">\n                <h1 class=\"mbr-section-title mbr-white mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Key <span style=\"font-weight: 400;\">to </span>Home <span style=\"font-weight: 400;\">Ownership.</span></h1>\n                <div class=\"typed-text pb-3\" mbr-class=\"{'display-1':wordsTitle=='title1','display-2':wordsTitle=='title2',\n                                      'display-5':wordsTitle=='title3','display-7':wordsTitle=='text',\n                                      'display-4':wordsTitle=='menu'}\" mbr-if=\"showSubtitle\">\n                    <span mbr-text class=\"mbr-section-subtitle mbr-fonts-style mbr-white\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-section-subtitle\">We</span>\n                    <span mbr-if=\"showAnimatedText\">\n                      <span class=\"animated-element mbr-bold\" data-word1=\"{{animatedWord1}}\" data-word2=\"{{animatedWord2}}\" data-word3=\"{{animatedWord3}}\" data-speed=\"{{typeSpeed}}\">\n                      </span>\n                    </span>\n                </div>\n                <p class=\"mbr-section-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text,.mbr-section-btn\">We evolve financial models capable of achieving the best mortgage market rates. Our core competence is in financial scheme architecture including  passive income&nbsp;proficiency.</p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\" mbr-if=\"showButtons\" class=\"pt-3 mbr-section-btn\"><a class=\"btn btn-md btn-primary\" type=\"submit\" data-app-placeholder=\"Type Text\" href=\"about-us.html#extProgressBars4-1q\">LEARN MORE</a></div>\n            </div>\n        </div>\n    </div>\n    <div mbr-if=\"showArrow && fullScreen\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>","_cid":"sAE7n3zRS7","_anchor":"Home","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".card-wrapper":{"position":"relative","margin":"0.5rem","&:hover":{"img":{"transform":"scale(1.1)"}}},"@media (max-width: 1400px)":{".card-wrapper":{"margin":"0rem"}},".card":{"height":"fit-content"},"@media (min-width: 767px)":{".row":{"padding":"0 4rem"}},".icon":{"position":"absolute","bottom":"0","right":"0","padding":"1.5rem","transition":"0.3s","background":"@iconBg","&:hover":{"padding-right":"1rem","padding-left":"2rem"}},".card-box":{"padding":"3rem 3rem 4rem 3rem","width":"100%"},".card1":{"background-color":"@cardsBg1"},".card2":{"background-color":"@cardsBg2"},".card3":{"background-color":"@cardsBg3"},".card4":{"background-color":"@cardsBg4"},"img":{"width":"100%","transition":"5s","object-fit":"cover"},".img-wrap":{"max-height":"200px","overflow":"hidden"},".container":{"max-width":"1500px"},".card-img":{"position":"absolute","top":"0","left":"0","width":"100%","overflow":"hidden"},".mbr-iconfont":{"font-size":"1.3rem","color":"@iconColor","display":"flex","justify-content":"center"},"P":{"color":"#c1c1c1"},"@media (max-width: 1200px)":{".img-wrap":{"max-height":"180px"}},"@media (max-width: 992px)":{".card-box":{"margin":"0rem","padding":"2rem 2rem 6rem 2rem"},".col2, .col3, .col4":{"margin-top":"0rem"},".img-wrap":{"max-height":"180px"}},"@media (max-width: 767px)":{".card-box":{"padding":"1rem 2rem 5rem 1rem"},".number":{"margin":"auto"}},".mbr-text":{"color":"#cccccc"},".text2":{"color":"#333333"},".text3":{"color":"#333333"},".title2":{"color":"#c1c1c1"},".title1":{"color":"#c1c1c1"},".title3":{"color":"#c1c1c1"},".title4":{"color":"#c1c1c1"},".text4":{"color":"#efeeee"},".text1":{"color":"#efeeee"},".title3 B":{"color":"#c1c1c1"},"H1":{"color":"#333333"}},"_name":"features006","_customHTML":"<section class=\"features5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Show Main Title\" name=\"showmainTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Card Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconColor\" value=\"#333333\">\n        <input type=\"color\" title=\"Icons BG\" name=\"iconBg\" value=\"#55b4d4\">\n        <input type=\"color\" title=\"Cards 1 BG\" name=\"cardsBg1\" value=\"#333333\">\n        <input type=\"color\" title=\"Cards 2 BG\" name=\"cardsBg2\" value=\"#ffffff\" condition=\"cardsAmount > 1\">\n        <input type=\"color\" title=\"Cards 3 BG\" name=\"cardsBg3\" value=\"#ffffff\" condition=\"cardsAmount > 2\">\n        <input type=\"color\" title=\"Cards 4 BG\" name=\"cardsBg4\" value=\"#333333\" condition=\"cardsAmount > 3\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#efeeee\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#333333\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n\n        <h1 class=\"mbr-section-title mbr-semibold mbr-white align-center pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showmainTitle\">Our Services</h1>\n\n\n        <div class=\"row justify-content-center\" mbr-cards=\"bootstrap\">\n            <div class=\"card p-3 col-12 col-md-8\" mbr-class=\"{'col-lg-6': cardsAmount == '2',\n                             'col-lg-4': cardsAmount == '3', 'col-lg-3': cardsAmount == '4'}\">\n                <div class=\"card-wrapper card1\">\n                    <div class=\"img-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-2-590x393.webp\" alt=\"PMBs & other financial institutions\" title>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title title1 pb-1 align-left mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".title1\"><b>PMBs &amp; OTHER FINANCIAL INSTITUTIONS</b><br><b><br></b></h4>\n                        <p class=\"mbr-text align-left text1 mbr-regular mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".text1\">...we are armed with emerging or new city development proficiencies ...<br><br></p>\n                    </div>\n                    <a href=\"services.html#extAccordion8-u\"><span mbr-icon class=\"mbr-iconfont icon mobi-mbri-right mobi-mbri\"></span></a>\n                </div>\n            </div>\n            <div class=\"card col2 p-3 col-12 col-md-8\" mbr-if=\"cardsAmount > 1\" mbr-class=\"{'col-lg-6': cardsAmount == '2',\n                             'col-lg-4': cardsAmount == '3', 'col-lg-3': cardsAmount == '4'}\">\n                <div class=\"card-wrapper card2\">\n                    <div class=\"img-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-590x394.webp\" alt=\"To individual clients \" title>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title title2 pb-1 align-left mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".title2\"><b>TO  INDIVIDUAL CLIENTS</b><br><b><br></b><b><br></b></h4>\n                        <p class=\"mbr-text align-left text2 mbr-regular mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".text2\">...We enable clients accessibility To attractive property Equity Loans and mortgage....</p>\n                    </div>\n                    <a href=\"services.html#extAccordion8-u\"><span mbr-icon class=\"mbr-iconfont icon mobi-mbri-right mobi-mbri\"></span></a>\n                </div>\n            </div>\n\n            <div class=\"card col3 p-3 col-md-8\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-lg-3': cardsAmount == '4',\n                             'col-lg-4': cardsAmount == '3', 'col-lg-3': cardsAmount == '4'}\">\n                <div class=\"card-wrapper card3\">\n                    <div class=\"img-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-590x393.webp\" alt=\"To real estate & autonomous city developers\" title>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title title3 pb-1 align-left mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".title3\"><b>TO REAL ESTATE &amp; AUTONOMOUS CITY DEVELOPERS</b></h4>\n                        <p class=\"mbr-text align-left text3 mbr-regular mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".text3\">We facilitate the financing and easy marketability of real estate development&nbsp;<br><br></p>\n                    </div>\n                    <a href=\"services.html#extAccordion8-u\"><span mbr-icon class=\"mbr-iconfont icon mobi-mbri-right mobi-mbri\"></span></a>\n                </div>\n            </div>\n\n            <div class=\"card col4 p-3 col-md-8 col-lg-3\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper card4\">\n                    <div class=\"img-wrap\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-1-590x393.webp\" alt=\"Housing cooperatives\" title>\n                    </div>\n                    <div class=\"card-box\">\n                        <h4 class=\"card-title title4 pb-1 align-left mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".title4\"><b>TO HOUSING COOPERATIVES</b><br><br><b><br></b></h4>\n                        <p class=\"mbr-text align-left text4 mbr-regular mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".text4\">We provide advisory services In The setting up and successful, administration...</p>\n                    </div>\n                    <a href=\"services.html#extAccordion8-u\"><span mbr-icon class=\"mbr-iconfont icon mobi-mbri-right mobi-mbri\"></span></a>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>","_cid":"rpSfjvEG19","_anchor":"services-sm","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"& when not (@fullScreen)":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"img":{"width":"100%","height":"100%","transition":"5s","object-fit":"cover","margin":"auto","&:hover":{"transform":"scale(1.1)"}},".img-col":{"padding":"0","overflow":"hidden","text-align":"center","justify-content":"center","position":"relative"},"h2":{"padding":"0","margin":"0"},".title-wrap":{"display":"flex","align-items":"center","justify-content":"center"},".text-col":{"max-width":"650px","margin":"auto","padding":"6rem 6rem"},".mbr-section-btn":{"position":"absolute","bottom":"300px","left":"0","transform":"rotate(90deg)","transform-origin":"bottom left",".btn":{"margin":"0rem!important","min-width":"300px","span":{"transform":"rotate(-90deg)"}},"&:hover":{"span":{"transform":"rotate(-90deg) translateX(0.6rem)","margin":"0!important"}}},".mbr-iconfont":{"margin":"0!important"},".number":{"border-top":"2px solid currentColor","padding-top":"0.6rem","margin-right":"3rem","margin-bottom":"0","margin-top":"0.5rem"},"@media (max-width: 992px)":{".text-col":{"padding":"4rem 4rem"}},"@media (max-width: 767px)":{".mbr-section-btn":{"bottom":"0px","left":"0","transform":"rotate(0deg)"},".btn":{"padding":"0.6rem 0.8rem!important","min-width":"200px!important"},".text-col":{"padding":"2rem 1rem"}},"H2":{"color":"#333333"},".mbr-text":{"color":"#767676","text-align":"left"},"H3":{"color":"#232323"}},"_name":"content004","_customHTML":"<section class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#efeeee\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 text-col align-left\">\n                <h3 class=\"mbr-section-subtitle mbr-regular pb-2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubTitle\"><b>Origin</b>/ MORTGAGE</h3>\n                <h1 class=\"mbr-section-title mbr-semibold pb-4 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n<div><span style=\"font-size: 2.6rem;\">The Origin</span><br></div></h1>\n                <p class=\"mbr-text mbr-black mbr-regular mbr-light mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Mortgage Konsult Limited formation is precedent on the remarkable strides achieved by the real estate and mortgage department of the parent company, Pension Managers Nigeria Limited (PMNL) before the enactment of the 2004 Pension Act. The Act barred all organization engage in pension fund management or custodianship to jettison aboard every other engagement other than the core businesses of pension management, consequently, Mortgage Konsult Limited was incorporated to take over the real estate development and mortgage businesses of Pension Managers Nigeria Limited in 2008.</p>\n            </div>\n            <div class=\"col-lg-6 img-col\">\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1837x1225.webp\" alt=\"The origin\" title>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn pt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-primary\" href=\"about-us.html#tabs01-k\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>READ MORE</a></div>\n            </div>\n        </div>\n    </div>\n</section>","_cid":"rpSfqF8N8V","_anchor":"origin","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"& when not (@fullScreen)":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".container":{"max-width":"1500px"},"img":{"width":"100%","transition":"5s","object-fit":"cover","margin":"auto","&:hover":{"transform":"scale(1.1)"}},".row":{"background":"@boxbg"},".img-col":{"padding":"0","overflow":"hidden","text-align":"center","justify-content":"center","position":"relative","max-height":"540px","margin-bottom":"4rem"},"h2":{"padding":"0","margin":"0"},".title-wrap":{"display":"flex","align-items":"center","justify-content":"center"},".text-col":{"max-width":"700px","margin":"auto","padding":"0 4rem 4rem 4rem"},".mbr-section-btn":{"position":"absolute","bottom":"0","right":"0",".btn":{"margin":"0rem!important","min-width":"400px"}},".number":{"border-top":"2px solid currentColor","padding-top":"0.4rem","margin-right":"3rem","margin-bottom":"0","margin-top":"0.5rem"},"@media (max-width: 1200px)":{".row":{"margin":"2rem"}},"@media (max-width: 992px)":{".text-col":{"padding":"4rem 4rem"}},"@media (max-width: 767px)":{".btn":{"min-width":"200px!important","padding":"0.6rem 0.8rem!important"},".row":{"margin":"0rem"},".text-col":{"padding":"2rem 1rem"},".number":{"margin-right":"2rem"},".img-col":{"margin-bottom":"3rem"}},"H2":{"color":"#333333"},".mbr-text":{"color":"#767676"}},"_name":"content002","_customHTML":"<section class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Number\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Box Color\" name=\"boxbg\" value=\"#ffffff\" selected>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#efeeee\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#282124\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-lg-12 img-col\">\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1920x1010.webp\" alt=\"Project antecedents\" title>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn pt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-primary\" href=\"about-us.html#tabs01-k\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>READ MORE</a></div>\n            </div>\n            <div class=\"col-lg-5 title-col align-left\" mbr-if=\"showSubTitle || showTitle \">\n                <div class=\"title-wrap\">\n                    <h3 class=\"number mbr-medium mbr-black pb-2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubTitle\">01</h3>\n                    <h2 class=\"mbr-section-title mbr-semibold mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Project Antecedents</h2>\n                </div>\n            </div>\n\n            <div class=\"col-lg-7 text-col align-left\">\n                <p class=\"mbr-text mbr-black mbr-regular mbr-light mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">The Team of management in Pension Managers Nigerian Limited which later became Mortgage Konsult Limited developed innovative and novel mortgage schemes which culminated in the delivery of several affordable housing Projects. One of the product developed was Pension Linked Mortgage Scheme (PELMS) in 1999 and proposed to Union Homes Savings and Loans Plc, which was adopted in 2002 by the organization.<br></p>\n\n            </div>\n\n        </div>\n    </div>\n</section>","_cid":"rpSfl755ta","_anchor":"projects-sm","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"& when not (@fullScreen)":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".container":{"max-width":"1500px"},"img":{"width":"100%"},"h2":{"padding":"0","margin":"0"},".text-wrap":{"max-width":"500px","margin":"auto"},".number":{"border-top":"2px solid currentColor","padding-top":"0.4rem","margin-bottom":"0","margin-top":"0.5rem","width":"fit-content"},".img-col":{"position":"relative"},".img2":{"position":"absolute","right":"6rem","top":"-6rem","width":"320px"},"@media (max-width: 1200px)":{".img2":{"right":"3rem"}},"@media (max-width: 992px)":{".title-col":{"margin-bottom":"4rem!important"},".img2":{"top":"-2rem"},".text-wrap":{"max-width":"550px"}},"@media (max-width: 767px)":{".img2":{"width":"50%"},".number":{"margin":"auto"}},"H3":{"color":"#149dcc"}},"_name":"content006","_customHTML":"<section class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Number\" name=\"showSubTitle\" checked>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#efeeee\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 title-col m-auto align-left\">\n                <div class=\"text-wrap align-left\">\n                    <h3 class=\"number mbr-medium pb-4 mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubTitle\">01</h3>\n                    <h2 class=\"mbr-section-title pb-4 mbr-semibold mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Our Values</h2>\n                    <p class=\"mbr-text mbr-black mbr-regular mbr-light mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\"><b>Priority</b> – We put God first in all things.\n<br><b>Proficiency </b>\t– Having the culture of doing things right, first time, all the time.\n<br><b>Integrity</b> – We make our agreement our bond.\n<br><b>Innovation </b>– Keeping Track of the needs of our clientele and consistently evolving solutions ahead of manifest challenges.\n<br><b>Services dependability</b>\t– Ensuring delightful delivery and ownership of homes with amazing acquisition comfort.\n<br><b>Friendliness</b> - Continually cultivating positive service delivery attitude that evokes warmth, rhapsody, and hearty appreciation from our client.&nbsp;<br></p>\n                </div>\n            </div>\n            <div class=\"col-lg-6 img-col\">\n                <img class=\"img2\" src=\"@PROJECT_PATH@/assets/images/mbr-640x339.webp\" alt=\"Our values\" title>\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1440x810.webp\" alt=\"Our values\" title>\n            </div>\n\n        </div>\n    </div>\n</section>","_cid":"rpSfxBmryu","_anchor":"values","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"& when not (@fullScreen)":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".container":{"max-width":"1500px"},"img":{"width":"100%"},"h2":{"padding":"0","margin":"0"},".text-wrap":{"max-width":"500px","margin":"auto"},".number":{"border-top":"2px solid currentColor","padding-top":"0.4rem","margin-bottom":"0","margin-top":"0.5rem","width":"fit-content"},".img-col":{"position":"relative"},".img2":{"position":"absolute","left":"-6rem","top":"4rem","width":"280px"},"@media (max-width: 1200px)":{".img2":{"left":"1rem"}},"@media (max-width: 992px)":{".img-col":{"margin-bottom":"3rem"},".text-wrap":{"max-width":"550px"}},"@media (max-width: 767px)":{".img2":{"width":"50%","top":"2rem"},".number":{"margin":"auto"}},"H3":{"color":"#149dcc"}},"_name":"team001","_customHTML":"<section class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Number\" name=\"showSubTitle\" checked>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#efeeee\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 img-col\">\n                <img class=\"img2\" src=\"@PROJECT_PATH@/assets/images/mbr-560x373.webp\" alt=\"vision and mission\" title>\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1440x962.webp\" alt=\"Vision and mission\" title>\n            </div>\n            <div class=\"col-lg-6 title-col m-auto align-left\">\n                <div class=\"text-wrap align-left\">\n                    <h3 class=\"number mbr-medium mbr-black mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\">02</h3>\n                    <h2 class=\"mbr-section-title py-4 mbr-semibold mbr-black mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Our Vision and Mission</h2>\n                    <p class=\"mbr-text mbr-black mbr-regular mbr-light mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                        To revolutionize home ownership in Nigeria and beyond, for most income brackets.<br><br>To become an ISO compliant company providing market sensitive <b>Real Estate development</b> and mortgage schemes that proffer effective solutions to <b>affordability challenges</b>.<br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>","_cid":"rpSfLZlmw9","_anchor":"vision-n-mission","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"_name":"countres2","_customHTML":"<section class=\"countres2 counters\" group=\"Counters\" plugins=\"ViewportChecker\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <!-- Paddings -->\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <!-- Elements params -->\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Show Number\" name=\"showNumber\" checked>\n        <input type=\"checkbox\" title=\"Show Card Title\" name=\"showTitles\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\">\n        <select title=\"Cards Count\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <!-- Backgrounds -->\n        <input type=\"color\" title=\"Card Background\" name=\"cardBackground\" value=\"#f8fefe\" selected>\n        <input type=\"color\" title=\"Card Border\" name=\"cardBorder\" value=\"#149dcc\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/claimm4/components/_images/bg_3.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#f9f9f9\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    \n    <div class=\"container\">\n        <div class=\"media-container-column\" mbr-if=\"showTitle || showSubtitle\">\n        <h2 class=\"mbr-section-title align-center mbr-fonts-style mb-0 mbr-bold\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n            Counters</h2>\n        <h3 class=\"mbr-subtitle align-center mbr-fonts-style mt-2 mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-subtitle\">\n            Mobirise is a beautiful site constructor\n        </h3>\n        </div>\n        \n            <div class=\"media-container-row\">\n                <div class=\"card align-center col-12 col-md-6\" mbr-class=\"{'col-lg-3': cardsAmount == '4','col-lg-4': cardsAmount == '3'}\">\n                    <div class=\"panel-item\">\n                         <div class=\"card-text\">\n                            <h3 class=\"number mbr-fonts-style mb-2 mbr-bold\" mbr-if=\"showNumber\" mbr-theme-style=\"display-2\" data-app-selector=\".number\">50K</h3>\n                            <h4 class=\"mbr-content-title mbr-regular mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showTitles\">Offers</h4>\n                            <p class=\"mbr-content-text mbr-fonts-style mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-content-text\">\n                                Lorem ipsum dolor sit amet, consectetur adipisicing elit. At, consequatur cumque eos hicventore omnis perferendis qui quidem suscipit.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n\n                <div class=\"card align-center col-12 col-md-6\" mbr-if=\"cardsAmount>1\" mbr-class=\"{'col-lg-3': cardsAmount == '4','col-lg-4': cardsAmount == '3'}\">\n                    <div class=\"panel-item\">\n                        <div class=\"card-text\">\n                            <h3 class=\"number mbr-fonts-style mb-2 mbr-bold\" mbr-if=\"showNumber\" mbr-theme-style=\"display-2\" data-app-selector=\".number\">10</h3>\n                            <h4 class=\"mbr-content-title mbr-regular mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showTitles\">Projects per year</h4>\n                            <p class=\"display-7 mbr-content-text mbr-fonts-style mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-content-text\">\n                                Lorem ipsum dolor sit amet, consectetur adipisicing elit. At, consequatur cumque eos hic\n                                inventore omnis perferendis qui quidem suscipit.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"card align-center col-12 col-md-6\" mbr-if=\"cardsAmount>2\" mbr-class=\"{'col-lg-3': cardsAmount == '4','col-lg-4': cardsAmount == '3'}\">\n                    <div class=\"panel-item\">\n                        <div class=\"card-text\">\n                            <h3 class=\"number mbr-fonts-style mb-2 mbr-bold\" mbr-if=\"showNumber\" mbr-theme-style=\"display-2\" data-app-selector=\".number\">1K</h3>\n                            <h4 class=\"mbr-content-title mbr-regular mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showTitles\">Sales per year</h4>\n                            <p class=\"display-7 mbr-content-text mbr-fonts-style mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-content-text\">\n                                Lorem ipsum dolor sit amet, consectetur adipisicing elit. At, consequatur cumque eos hic\n                                inventore omnis perferendis qui quidem suscipit.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n\n                <div class=\"card align-center col-12 col-md-6\" mbr-if=\"cardsAmount>3\" mbr-class=\"{'col-lg-3': cardsAmount == '4','col-lg-4': cardsAmount == '3'}\">\n                    <div class=\"panel-item\">\n                        <div class=\"card-text\">\n                            <h3 class=\"number mbr-fonts-style mb-2 mbr-bold\" mbr-if=\"showNumber\" mbr-theme-style=\"display-2\" data-app-selector=\".number\">15</h3>\n                            <h4 class=\"mbr-content-title mbr-regular mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showTitles\">Repairs per day</h4>\n                            <p class=\"display-7 mbr-content-text mbr-fonts-style mb-0 mt-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-content-text\">\n                                Lorem ipsum dolor sit amet, consectetur adipisicing elit. At, consequatur cumque eos hicinventore omnis perferendis qui quidem suscipit.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n</section>","_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = \"color\")":{"background-color":"@bg-value"},"& when (@bg-type = \"image\")":{"background-image":"url(@bg-value)"},".card-text":{"background-color":"@cardBackground","padding":"1.5rem","border-width":"0 0 4px 0","border-style":"solid","border-color":"@cardBorder"},".media-container-column":{"margin-bottom":"2rem"},".mbr-content-text":{"text-align":"left"},".numder":{"text-align":"left","color":"#000000"},"H4":{"text-align":"left"},"@media (max-width: 991px)":{".panel-item":{"margin-bottom":"1.5rem"}},".number":{"text-align":"left"}},"_cid":"sAEqrcg8Mx","_anchor":"stats","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)",".mbr-overlay":{"background-color":"@overlayColor","opacity":"@overlayOpacity"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@customStyle)":{"input, textarea":{"border-left":"none","border-top":"none","border-right":"none","border-radius":"0","min-height":"3rem","padding":"0rem!important","font-size":"1rem","&:focus":{"border-left":"none","border-top":"none","border-right":"none"}},".form-control, .field-input":{"padding":"0.5rem","background-color":"@fieldColor","border-color":"@borderColor","color":"@formText","transition":"0.4s","box-shadow":"none","outline":"none","&:hover, &:focus":{"background-color":"@fieldHover","border-color":"@borderHover","color":"contrast(@formText, #000000, #ffffff, 30%)","box-shadow":"none","outline":"none"}},"input::-webkit-input-placeholder, textarea::-webkit-input-placeholder":{"color":"@formPlaceholder"},"input:-moz-placeholder, textarea:-moz-placeholder":{"color":"@formPlaceholder"},".jq-selectbox li, .jq-selectbox li":{"background-color":"@fieldColor","color":"contrast(@fieldColor, #000000, #ffffff, 30%)"},".jq-selectbox li:hover, .jq-selectbox li.selected":{"background-color":"@fieldHover","color":"contrast(@fieldHover, #000000, #ffffff, 30%)"},".jq-selectbox:hover .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldColor"},".jq-selectbox .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldHover"}},"img":{"width":"100%","height":"100%","object-fit":"cover"},".mbr-form":{"max-width":"450px"},"textarea":{"min-height":"150px"},".mbr-text":{"color":"#cccccc"},".mbr-form .btn":{"width":"100%","justify-content":"space-between",".mbr-iconfont":{"font-size":"1.5rem","order":"2"}}},"_name":"form001","_customHTML":"<section class=\"form\" group=\"Form\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked=\"\">\n\n        <header>Style</header>\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked=\"\">\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#333333\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#333333\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#cccccc\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#cccccc\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#cccccc\" condition=\"customStyle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/assets/background.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#333333\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"true\"></mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay &amp;&amp; bg.type=='image')\"></div>\n    <div class=\"container-fluid\">\n        <div class=\"row\">\n            <div mbr-form=\"\" class=\"col-lg-6 mx-auto py-5 mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"info@mortgagekonsult.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-rcpha=\"true\" data-rcpha_sitekey=\"6Ld_rAkqAAAAAABljj3a362nD_JPHvyxemrq9eT0\" data-rcpha_secretkey=\"6Ld_rAkqAAAAAMM5eTK66xqhVNFjgrGJpUZyUCGp\" data-rcpha_label=\"true\">\n<div class=\"form-row\">\n<div hidden=\"hidden\" data-form-alert=\"\" class=\"alert alert-success col-12\">Thanks for filling out the form!</div>\n<div hidden=\"hidden\" data-form-alert-danger=\"\" class=\"alert alert-danger col-12\">Oops...! some problem!</div>\n</div>\n<div class=\"dragArea form-row\">\n<div class=\"col-lg-12\">\n<h2 mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" class=\"mbr-section-title align-left pb-4 mbr-semibold mbr-white mbr-fonts-style\">Connect with us</h2>\n</div>\n<div class=\"col-lg-12\">\n<p mbr-theme-style=\"display-4\" mbr-if=\"showText\" class=\"mbr-text mbr-black align-left pb-4 mbr-regular mbr-light mbr-fonts-style\">Please write us at any time you would have any kind of concern or question. We would enjoy to help you.</p>\n</div>\n<div data-for=\"first-name\" class=\"col-lg-12 form-group\">\n<input type=\"text\" name=\"first-name\" placeholder=\"First Name\" data-form-field=\"first-name\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"last-name\" class=\"col-lg-12 form-group\">\n<input type=\"text\" name=\"last-name\" placeholder=\"Last Name\" data-form-field=\"last-name\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"company\" class=\"col-lg-12 form-group\">\n<input type=\"text\" name=\"company\" placeholder=\"Company\" data-form-field=\"company\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"email\" class=\"col-lg-12 form-group\">\n<input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div class=\"col-lg-12 form-group\" data-for=\"phone\">\n<input type=\"tel\" name=\"phone\" placeholder=\"Phone\" pattern=\"*\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" class=\"form-control\" value=\"\">\n</div>\n<div data-for=\"message\" class=\"col-lg-12 form-group\">\n<textarea name=\"message\" placeholder=\"Message\" data-form-field=\"message\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n</div>\n<div mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-lg-12 mbr-section-btn\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 btn btn-primary\">WAY TO GO!</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n\n            <div class=\"col-lg-6 img-col\">\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1777x1184.webp\" alt=\"Connect with us\" title=\"\">\n            </div>\n        </div>\n\n    </div>\n</section>","_cid":"rpSfOyO5kY","_anchor":"contact","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"img":{"width":"40px","margin-right":"1rem"},".navbar-brand":{"display":"flex","align-items":"center"},"@media (max-width: 1200px)":{".row":{"margin":"0 2rem"}},".container":{"max-width":"1500px"},"& when (@customStyle)":{".form-control, .field-input":{"padding":"0.5rem","background-color":"@fieldColor","border-color":"@borderColor","color":"@formText","transition":"0.4s","box-shadow":"none","outline":"none","&:hover, &:focus":{"background-color":"@fieldHover","border-color":"@borderHover","color":"contrast(@formText, #000000, #ffffff, 30%)","box-shadow":"none","outline":"none"}},"input::-webkit-input-placeholder, textarea::-webkit-input-placeholder":{"color":"@formPlaceholder"},"input:-moz-placeholder, textarea:-moz-placeholder":{"color":"@formPlaceholder"},".jq-selectbox li, .jq-selectbox li":{"background-color":"@fieldColor","color":"contrast(@fieldColor, #000000, #ffffff, 30%)"},".jq-selectbox li:hover, .jq-selectbox li.selected":{"background-color":"@fieldHover","color":"contrast(@fieldHover, #000000, #ffffff, 30%)"},".jq-selectbox:hover .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldColor"},".jq-selectbox .jq-selectbox__trigger-arrow":{"border-top-color":"@fieldHover"}},".btn":{"width":"80px!important","justify-content":"center","padding":"1rem 1rem!important","margin":"0!important","height":"100%",".mbr-iconfont":{"font-size":"1.2rem"}},"input":{"border-radius":"0","padding":"1rem!important","font-size":"1rem","height":"100%"},".col, .col-auto":{"padding":"0"},".form-group":{"margin-bottom":"0rem"},".items":{"color":"#0f7699"},".form-title":{"color":"#0f7699"},"@media (max-width: 992px)":{".col-md-6, .navbar-brand":{"margin-bottom":"2rem"}},"@media (max-width: 767px)":{".navbar-brand":{"justify-content":"center"},".row":{"margin":"0"}},"SPAN":{"color":"#0f7699"}},"_name":"footer003","_customHTML":"<section class=\"footer2\" group=\"Footers\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"range\" inline title=\"Col 1 Items\" name=\"items1\" min=\"0\" max=\"5\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Col 2 Items\" name=\"items2\" min=\"0\" max=\"5\" step=\"1\" value=\"2\">\n\n        <header>Form Style</header>\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#efeeee\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#efeeee\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#efeeee\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#efeeee\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#333333\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#767676\" condition=\"customStyle\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1280.webp\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-4 col-md-12 align-left\">\n                <div class=\"navbar-brand\">\n                    <span class=\"navbar-logo\" mbr-if=\"showLogo\">\n                        <img src=\"@PROJECT_PATH@/assets/images/logo-80x36.png\" alt=\"Mortgage Konsult\">\n                    </span>\n                    <span mbr-text mbr-theme-style=\"display-5\" class=\"mbr-fonts-style mbr-semibold navbar-caption-wrap\" mbr-if=\"showTitle\">Mortgage Konsult Limited</span>\n\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-2 col-md-6 align-left\" mbr-if=\"items1 > 0\">\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 0\" data-app-selector=\".items\">About Us</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 1\" data-app-selector=\".items\">Services</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 2\" data-app-selector=\".items\">Gallery</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 3\" data-app-selector=\".items\">Contact</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items1 > 4\" data-app-selector=\".items\">About Us</h5>\n            </div>\n\n            <div class=\"col-12 col-lg-2 col-md-6 align-left\" mbr-if=\"items2 > 0\">\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 0\" data-app-selector=\".items\">Contact</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 1\" data-app-selector=\".items\">Book a sales rep</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 2\" data-app-selector=\".items\">Economics</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 3\" data-app-selector=\".items\">Supply</h5>\n                <h5 class=\"mbr-fonts-style items mbr-semibold pb-2\" mbr-theme-style=\"display-4\" mbr-if=\"items2 > 4\" data-app-selector=\".items\">About Us</h5>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-12\">\n                <h5 class=\"mbr-fonts-style align-left form-title mbr-semibold pb-4\" mbr-theme-style=\"display-4\" data-app-selector=\".form-title\">Sign up for our Newsletter</h5>\n                <form action name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n                    <div class=\"form-row\">\n                        <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling\n                            out\n                            the form!</div>\n                        <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some\n                            problem!</div>\n                    </div>\n                    <div class=\"dragArea form-row\">\n                        <div class=\"col form-group\" data-for=\"email\">\n                            <input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n                        </div>\n                        <div class=\"col-auto\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                    </div>\n                </form>\n\n            </div>\n        </div>\n    </div>\n</section>","_cid":"rpSfRe8AXs","_anchor":"subscribe","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},".media-container-row .mbr-text":{"color":"#333333"}},"_name":"footer002","_customHTML":"<section class=\"footer2\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@ADDONS_PATH@/industrym4/components/_images/background5.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#efeeee\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mbr-regular mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2021 Mortgage Konsult -&nbsp;3b Ribadu Road, Off Awolowo Road, Ikoyi, Lagos - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>","_cid":"rpSfRqtWyh","_anchor":"footer002-31","_sourceTheme":"mobirise4-blocks-theme","_protectedParams":[],"_global":true,"_once":"footers","_params":{}}]},"about-us.html":{"settings":{"title":"About Us","meta_descr":"Mortgage Konsult Limited is a premier mortgage Consultancy out fit in the country. Incorporated on the 29th of July 2008 to carry out Real Estate Development and Consultancy services and Mortgage Financing with registration number 763070, the company’s thrust is to evolve construction and mortgage solutions to the insuperable challenges that are responsible for the alarming housing deficit in the country.","header_custom":"","footer_custom":"","html_before":"","order":1},"components":[{"_name":"header5","_customHTML":"<section group=\"Headers header5\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen}\">\n<!-- ,\n         'scroll-background': scrollBackground -->\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Show Arrow\" name=\"showArrow\" condition=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Scroll Bg\" name=\"scrollBg\" checked>\n        <input type=\"range\" title=\"Scroll Time\" name=\"scrollTime\" min=\"1\" max=\"60\" step=\"1\" value=\"30\" condition=\"scrollBg && bg.type == 'image'\" inline>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1296.webp\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#dddddd\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"scroll-wrapper\" mbr-style=\"{'animation-duration':scrollTime+'s'}\"></div>\n    <div class=\"scroll-wrapper second\" mbr-if=\"scrollBg\" mbr-style=\"{'animation-duration':scrollTime+'s'}\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\">\n    </div>\n    <div class=\"container-fluid text-center block-content\" data-stellar-background-ratio=\".5\">\n      <div class=\"row justify-content-center slider-wrapper\" mbr-if=\"showTitle || showSubtitle\">\n        <div class=\"col-md-10\">\n              <h2 mbr-if=\"showTitle\" class=\"mbr-section-title mbr-fonts-style align-left mbr-black\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-section-title\">\n                  About <b>Mortgage Konsult</b></h2>\n              <h4 class=\"mbr-section-subtitle mbr-fonts-style align-left mbr-black pt-3\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-subtitle,.mbr-section-btn\">Mortgage Konsult Limited is a premier mortgage Consultancy out fit in the country. Incorporated on the 29th of July 2008 to carry out Real Estate Development and Consultancy services and Mortgage Financing with registration number 763070, the company’s thrust is to evolve construction and mortgage solutions to the insuperable challenges that are responsible for the alarming housing deficit in the country.</h4>\n              <div class=\"mbr-section-btn align-left pt-3\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-primary\" href=\"about-us.html#about-us\" data-app-placeholder=\"Type Text\">LEARN MORE</a></div>\n        </div>\n      </div>\n    </div>\n    <div mbr-if=\"showArrow && fullScreen\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>","_styles":{"overflow-x":"hidden !important",".container-fluid":{"padding":"0 3rem"},".scroll-wrapper":{"top":"0","width":"100%","height":"100%","background-position":"100% 0","background-size":"cover","position":"absolute","background-repeat":"repeat","z-index":"0","-webkit-animation-duration":"~\"@{scrollTime}s\" !important","animation-duration":"~\"@{scrollTime}s\"","& when not (@fullScreen)":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)"},"& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)","& when (@scrollBg)":{"-webkit-animation":"scroll-wrapper linear infinite","-moz-animation":"scroll-wrapper linear infinite","-o-animation":"scroll-wrapper linear infinite","animation":"scroll-wrapper linear infinite","-webkit-transform":"translateZ(0)","transform":"translateZ(0)"}},"&.second":{"left":"~\"calc(100% - 1px)\"","background-position":"0 0"}},".mbr-overlay":{"z-index":"1"},".block-content":{"z-index":"2","& when not (@fullScreen)":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)"}},"@keyframes scroll-wrapper":{"0%":{"-webkit-transform":"translateX(0)","transform":"translateX(0)"},"100%":{"-webkit-transform":"translateX(-100%)","transform":"translateX(-100%)"}},"@-webkit-keyframes scroll-wrapper":{"0%":{"-webkit-transform":"translateX(0)","transform":"translateX(0)"},"100%":{"-webkit-transform":"translateX(-100%)","transform":"translateX(-100%)"}},"@-moz-keyframes scroll-wrapper":{"0%":{"-webkit-transform":"translateX(0)","transform":"translateX(0)"},"100%":{"-webkit-transform":"translateX(-100%)","transform":"translateX(-100%)"}},"@-o-keyframes scroll-wrapper":{"0%":{"-webkit-transform":"translateX(0)","transform":"translateX(0)"},"100%":{"-webkit-transform":"translateX(-100%)","transform":"translateX(-100%)"}},"@media (max-width: 767px)":{".container-fluid":{"padding":"0 1rem"}},".mbr-section-title":{"color":"#232323"},".mbr-section-subtitle,.mbr-section-btn":{"color":"#383232"}},"_cid":"sAMyMnDarp","_anchor":"About-Us","_sourceTheme":"mobirise4-blocks-theme","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},"h3":{"text-align":"center","font-weight":"300"},".progress":{"width":"100%"},".title-wrap":{"display":"flex","-webkit-justify-content":"space-between","justify-content":"space-between"},"progress":{"height":"inherit"},".progressbar-number":{"display":"inline-block"},".progress-primary":{"background":"rgba(206, 206, 206, 0.4)","border":"none","outline":"none"},".progress-primary::-webkit-progress-bar":{"background":"rgba(206, 206, 206, 0.4)"},".mbr-section-subtitle":{"color":"#767676","text-align":"left"},".section-content-title":{"font-weight":"500"},".progress_value":{"position":"relative"},".progress1 .progressbar-number:before, .progress2 .progressbar-number:before, .progress3 .progressbar-number:before, .progress4 .progressbar-number:before, .progress5 .progressbar-number:before":{"position":"absolute","right":"15px","top":"0"},"progress[value]::-webkit-progress-bar":{"background":"rgba(206, 206, 206, 0.4)"},"progress::-webkit-progress-value":{"background":"@progressColor","& when (@gradientProgress)":{"background":"linear-gradient(90deg, @progressColor, @progressColor2)"}},"progress[value]::-moz-progress-bar":{"background":"@progressColor","& when (@gradientProgress)":{"background":"linear-gradient(90deg, @progressColor, @progressColor2)"}},"progress::-ms-fill":{"background":"@progressColor","& when (@gradientProgress)":{"background":"linear-gradient(90deg, @progressColor, @progressColor2)"}},".progress1 .progressbar-number:before":{"content":"'@{progress1}'"},".progress2 .progressbar-number:before":{"content":"'@{progress2}'"},".progress3 .progressbar-number:before":{"content":"'@{progress3}'"},".progress4 .progressbar-number:before":{"content":"'@{progress4}'"},".progress5 .progressbar-number:before":{"content":"'@{progress5}'"},".progress-container":{"display":"flex","-webkit-align-items":"center","align-items":"center","position":"relative","height":"1.8rem","width":"100%","span.progress-title":{"position":"absolute","padding-left":"2rem","font-size":"1rem !important","top":"50%","-webkit-transform":"translateY(-50%)","transform":"translateY(-50%)","height":"24px","overflow":"hidden","max-width":"85%"},".progress_value":{"position":"absolute","right":"2rem","top":"50%","-webkit-transform":"translateY(-50%)","transform":"translateY(-50%)","font-size":"1rem !important"}},"@media all and (~'-ms-high-contrast: none'), (~'-ms-high-contrast: active')":{".progress_value":{"margin-top":"-10px"}},"& when not (@reverseContent)":{"@media (min-width: 768px)":{".text-elements":{"padding-right":"3rem"},".progress_elements":{"padding-left":"3rem"}}},"& when (@reverseContent)":{"@media (min-width: 768px)":{".text-elements":{"padding-left":"3rem"},".progress_elements":{"padding-right":"3rem"}}},".progress_elements":{"margin-bottom":"-3rem"},".mbr-section-title":{"text-align":"left","color":"#0f7699"}},"_name":"extProgressBars4","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"extProgressBars\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"color\" title=\"Progress Color\" name=\"progressColor\" value=\"#ffffff\">\n        <input type=\"checkbox\" title=\"Gradient Progress\" name=\"gradientProgress\">\n        <input type=\"color\" title=\"Progress Color 2\" name=\"progressColor2\" value=\"#ffbaee\" condition=\"gradientProgress\">\n\n        <select title=\"Progress count\" name=\"progressCount\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"range\" inline title=\"Progress 1\" name=\"progress1\" min=\"0\" max=\"100\" step=\"1\" value=\"100\">\n        <input type=\"range\" inline title=\"Progress 2\" name=\"progress2\" min=\"0\" max=\"100\" step=\"1\" value=\"90\" condition=\"progressCount>1\">\n        <input type=\"range\" inline title=\"Progress 3\" name=\"progress3\" min=\"0\" max=\"100\" step=\"1\" value=\"80\" condition=\"progressCount>2\">\n        <input type=\"range\" inline title=\"Progress 4\" name=\"progress4\" min=\"0\" max=\"100\" step=\"1\" value=\"70\" condition=\"progressCount>3\">\n        <input type=\"range\" inline title=\"Progress 5\" name=\"progress5\" min=\"0\" max=\"100\" step=\"1\" value=\"60\" condition=\"progressCount>4\">\n\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=E0Pa8tYo94U\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>  \n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <h2 class=\"mbr-section-title pb-3 align-center mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n            Our&nbsp;<b>Mission:</b><br><b> Resolving Chronic Socioeconomic Challenges</b></h2>\n\n        <h3 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">We specialize in creating and tailoring financial concepts and models to address complex societal issues. Our key focus areas include:<div><br></div><div><b>+ Affordable National Mortgage Solutions</b></div><div><span style=\"font-size: 1.4rem;\">Developed the Mortgage Credit Guarantee Scheme (MCGS)</span><br></div><div>Curated initiatives like:</div><div>a) Federal Integrated Staff Housing Programme (FISH-p)</div><div>b) National Social Housing Programme (NSHP)</div><div><br></div><div><span style=\"font-size: 1.4rem;\"><b>+ Addressing High Mortality and Poverty Rates</b></span><br></div><div><span style=\"font-size: 1.4rem;\">Created a Hybrid Insurance Scheme covering Health and Life risks in Akwa Ibom State</span><br></div><div>Aimed to alleviate the embalming crisis caused by high mortality and poverty</div><div><br></div><div><b>+ Sustainable Urban Development</b></div><div><span style=\"font-size: 1.4rem;\">Designed National Affordable Mortgage Scheme and Guarantee trading</span><br></div><div>Supported projects like the Gulf Eye City in Akwa Ibom State</div></h3>\n\n        <div class=\"row pt-5 mt-5\">\n            <div class=\"col-md-6 text-elements\" mbr-class=\"{'order-2 pt-md-0 pt-3':reverseContent, 'pb-md-0 pb-3':!reverseContent}\">\n                <h4 class=\"section-content-title pb-3 align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".section-content-title\"></h4>\n                <p class=\"section-content-text align-left mbr-fonts-style m-0\" mbr-theme-style=\"display-7\" data-app-selector=\".section-content-text\"></p>\n            </div>\n            <div class=\"progress_elements col-md-6\">\n                <div class=\"progress1 pb-5\">\n                    <div class=\"progress-container\">\n                        <span mbr-text class=\"progress-title mbr-fonts-style mbr-bold mbr-white\" mbr-theme-style=\"display-7\" data-app-selector=\".progress-title,.progress_value,.progress_value span\">\n                              Consulting\n                        </span>\n                        <div class=\"progress_value mbr-bold mbr-white\">\n                            <div class=\"progressbar-number\"></div>\n                            <span>%</span>\n                        </div>\n                        <progress class=\"progress progress-primary\" value=\"{{progress1}}\" max=\"100\">\n                        </progress>\n                    </div>\n                </div>\n                 \n                <div class=\"progress2 pb-5\" mbr-if=\"progressCount>1\">\n                    <div class=\"progress-container\">\n                        <span mbr-text class=\"progress-title mbr-fonts-style mbr-bold mbr-white\" mbr-theme-style=\"display-7\" data-app-selector=\".progress-title,.progress_value,.progress_value span\">\n                              Life Insurance\n                        </span>\n                        <div class=\"progress_value mbr-bold mbr-white\">\n                            <div class=\"progressbar-number\"></div>\n                            <span>%</span>\n                        </div>\n                        <progress class=\"progress progress-primary\" value=\"{{progress2}}\" max=\"100\">\n                        </progress>\n                    </div>\n                </div>\n                \n                <div class=\"progress3 pb-5\" mbr-if=\"progressCount>2\">\n                    <div class=\"progress-container\">\n                        <span mbr-text class=\"progress-title mbr-fonts-style mbr-bold mbr-white\" mbr-theme-style=\"display-7\" data-app-selector=\".progress-title,.progress_value,.progress_value span\">\n                              Accounting\n                        </span>\n                        <div class=\"progress_value mbr-bold mbr-white\">\n                             <div class=\"progressbar-number\"></div>\n                             <span>%</span>\n                        </div>\n                        <progress class=\"progress progress-primary\" value=\"{{progress3}}\" max=\"100\">\n                        </progress>\n                    </div>\n                </div>\n                \n                <div class=\"progress4 pb-5\" mbr-if=\"progressCount>3\">\n                    <div class=\"progress-container\">\n                        <span mbr-text class=\"progress-title mbr-fonts-style mbr-bold mbr-white\" mbr-theme-style=\"display-7\" data-app-selector=\".progress-title,.progress_value,.progress_value span\">\n                              Entrepreneurship\n                        </span>\n                       <div class=\"progress_value mbr-bold mbr-white\">\n                            <div class=\"progressbar-number\"></div>\n                            <span>%</span>\n                        </div>\n                        <progress class=\"progress progress-primary\" value=\"{{progress4}}\" max=\"100\">\n                        </progress>\n                    </div>\n                </div>\n            \n                <div class=\"progress5 pb-5\" mbr-if=\"progressCount>4\">\n                    <div class=\"progress-container\">\n                        <span mbr-text class=\"progress-title mbr-fonts-style mbr-bold mbr-white\" mbr-theme-style=\"display-7\" data-app-selector=\".progress-title,.progress_value,.progress_value span\">\n                              Online Solution\n                        </span>\n                        <div class=\"progress_value mbr-bold mbr-white\">\n                            <div class=\"progressbar-number\"></div>\n                            <span>%</span>\n                        </div>\n                        <progress class=\"progress progress-primary\" value=\"{{progress5}}\" max=\"100\">\n                        </progress>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>","_cid":"ukPZRaaIr7","_anchor":"extProgressBars4-1q","_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".mbr-section-subtitle":{"color":"#0f7699","text-align":"left"},"ul.list-inline":{"margin":"0","-webkit-align-self":"center","align-self":"center","li":{"margin":"0","padding":".5rem"},"img":{"max-width":"6rem","padding-bottom":".5rem","& when (@grayFilter)":{"-webkit-filter":"grayscale(100%)","-moz-filter":"grayscale(100%)","-ms-filter":"grayscale(100%)","-o-filter":"grayscale(100%)","filter":"gray"},"&:hover":{"-webkit-filter":"none","-moz-filter":"none","-ms-filter":"none","-o-filter":"none","filter":"none"}}},"@media (max-width: 767px)":{".list-inline-item img":{"max-width":"5rem"}},".mbr-section-title DIV":{"text-align":"left"},".mbr-section-title":{"text-align":"left"}},"_name":"extInfo1","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"extInfo\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!--Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Gray Filter\" name=\"grayFilter\">\n        <input type=\"checkbox\" title=\"Visa\" name=\"showVisa\" checked>\n        <input type=\"checkbox\" title=\"Master Card\" name=\"showMasterCard\" checked>\n        <input type=\"checkbox\" title=\"American Express\" name=\"showAmericanExpress\" checked>\n        <input type=\"checkbox\" title=\"Pay Pal\" name=\"showPayPal\" checked>\n        <input type=\"checkbox\" title=\"Diners Club\" name=\"showDinersClub\">\n        <input type=\"checkbox\" title=\"Discover\" name=\"showDiscover\">\n        <input type=\"checkbox\" title=\"Bitcoin\" name=\"showBitcoin\">\n        <input type=\"checkbox\" title=\"Western Union\" name=\"showWesternUnion\">\n        <input type=\"checkbox\" title=\"JCB\" name=\"showJcb\">\n        <input type=\"checkbox\" title=\"Stripe\" name=\"showStripe\">\n        <input type=\"checkbox\" title=\"Amazon\" name=\"showAmazon\">\n        <input type=\"checkbox\" title=\"Ebay\" name=\"showEbay\">\n        <input type=\"checkbox\" title=\"Union Pay\" name=\"showUnionPay\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/411-1000x1500.webp\" selected parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#e4e5fb\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-12\" mbr-if=\"showTitle || showSubtitle\">\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style pb-2 mbr-light align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-class=\"{'pb-4':!showTitle}\"><b>Collaborations</b></h3>\n                <h2 class=\"align-center mbr-fonts-style mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">We've partnered with key organizations including:<div><br></div><div>- Federal Mortgage Bank of Nigeria</div><div>- Federal Ministry of Housing</div><div>- Office of the Head of the Civil Service of the Federation</div><div>- Family Homes Funds Limited</div><div><br></div><div><i>Our innovative financial solutions aim to create lasting positive impact on communities and improve quality of life.</i></div></h2>\n            </div>\n\n            <div class=\"col-12 col-md-12\" mbr-class=\"{'pt-4':showTitle}\">\n                <div class=\"row justify-content-center\">\n                    <ul class=\"list-inline align-center\">\n                        <li class=\"list-inline-item\" mbr-if=\"showVisa\">\n                            <img src=\"@PROJECT_PATH@/assets/images/hsc-192x108.webp\" alt=\"HSC\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showMasterCard\">\n                            <img src=\"@PROJECT_PATH@/assets/images/fhf-192x192.webp\" alt=\"FHF\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showAmericanExpress\">\n                            <img src=\"@PROJECT_PATH@/assets/images/fmb-192x124.webp\" alt=\"FMB\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showPayPal\">\n                            <img src=\"@PROJECT_PATH@/assets/images/fmwh-192x108.webp\" alt=\"FMWH\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showDinersClub\">\n                            <img src=\"../_images/payments/diners-club.png\" alt=\"Diners Club\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showDiscover\">\n                            <img src=\"../_images/payments/discover.png\" alt=\"Discover\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showBitcoin\">\n                            <img src=\"../_images/payments/bitcoin.png\" alt=\"Bitcoin\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showWesternUnion\">\n                            <img src=\"../_images/payments/western-union.png\" alt=\"Western Union\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showJcb\">\n                            <img src=\"../_images/payments/jcb.png\" alt=\"JCB\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showStripe\">\n                            <img src=\"../_images/payments/stripe.png\" alt=\"Stripe\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showAmazon\">\n                            <img src=\"../_images/payments/amazon.png\" alt=\"Amazon\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showEbay\">\n                            <img src=\"../_images/payments/ebay.png\" alt=\"Ebay\">\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"showUnionPay\">\n                            <img src=\"../_images/payments/union-pay.png\" alt=\"Union Pay\">\n                        </li>\n                    \n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>","_cid":"ukQ1xTdAMF","_anchor":"extInfo1-1r","_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = 'color')":{"background-color":"@bg-value"},"& when (@bg-type = 'image')":{"background-image":"url(@bg-value)"},".nav-tabs .nav-item.open .nav-link:focus, .nav-tabs .nav-link.active:focus":{"outline":"none"},".nav-tabs":{"-webkit-flex-wrap":"wrap","flex-wrap":"wrap","border-right":"1px solid @tabsColor","border-bottom":"none","padding-right":"4rem",".nav-item":{"padding":".5rem"}},"p":{"padding-left":"2rem","color":"#879a9f"},".col-md-12":{"flex-direction":"row","display":"flex"},".nav-tabs .nav-link":{"color":"@tabsColor","font-style":"normal","font-weight":"500","transition":"all .5s","border":"none","&:hover":{"cursor":"pointer","color":"@activeTabColor"},"&.active":{"font-weight":"500","color":"@activeTabColor","font-style":"normal"}},"@media (max-width: 992px)":{".nav-tabs":{"flex-direction":"row","border-right":"0px","padding-right":"0rem","border-bottom":"1px solid lightgray"},".col-md-12":{"flex-direction":"column","display":"flex"},"p":{"padding-left":"0rem"}},"@media (max-width: 576px)":{".mbr-text, .nav-link":{"text-align":"center"},".col-md-12":{"flex-direction":"column","display":"flex"},".nav-tabs":{"border-right":"0px","padding-right":"0rem","flex-direction":"column"},"p":{"padding-left":"0rem"}}},"_name":"extTabs4","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"extTabs tabs\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mobirise-tabs\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n        <input type=\"color\" title=\"Tabs Color\" name=\"tabsColor\" value=\"#879a9f\">\n        <input type=\"color\" title=\"Active Tab Color\" name=\"activeTabColor\" value=\"#149dcc\">\n        <select title=\"Tabs Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <h2 class=\"align-left pb-5 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Innovative Technology\n        </h2>\n        <div class=\"row\">\n            <div class=\"col-12 col-md-12\">\n                <ul class=\"nav nav-tabs\" role=\"tablist\">\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" href=\"#extTabs4-i_tab0\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">Origin</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" href=\"#extTabs4-i_tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">Business concept</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" href=\"#extTabs4-i_tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Development</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs03-7_tab3\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Phases</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs1-1c_tab4\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Design</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 5\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" href=\"#tabs1-1c_tab5\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            Architecture</a></li>\n                </ul>\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">Mortgage Konsult Limited formation is precedent on the remarkable strides achieved by the real estate and mortgage department of the parent company, Pension Managers Nigeria Limited (PMNL) before the enactment of the 2004 Pension Act. The Act barred all organization engage in pension fund management or custodianship to jettison aboard every other engagement other than the core businesses of pension management, consequently, Mortgage Konsult Limited was incorporated to take over the real estate development and mortgage businesses of Pension Managers Nigeria Limited in 2008.\n<br>\n<br>Prior to 2008, Pension Managers Nigeria limited has set up a real estate and mortgage department (in 1990) to explore and proffer solutions to the high mortality rate that her retired civil servants clients were encountering at the time, as a result of using up all their pension and gratuity entitlement to acquire a home; leaving little or no sustained earnings. The unit was saddled with the mandate of exploring construction and mortgage avenues that employees could own a home while working and not on retirement.\n<br>\n<br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    To develop as well as put in place schemes that ensures the development of more reasonably priced houses and make those houses more affordable for a broad spectrum of the Nigerian income earning classes. Also to create inter- Industry participation in mortgage funding; capable of attracting cheaper long term loan funds to mortgage institutions, resulting in more attractive mortgage terms for mortgagors.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Nam ornare tortor quam, eget ultrices ex vulputate sit amet. Nulla ligula nisi, tincidunt nec fringilla tincidunt, dignissim in mi. Nullam sed enim faucibus, dictum sapien maximus, ultricies erat. Morbi et diam eu dui interdum egestas. Maecenas nisi turpis, varius ut ipsum at, dapibus tempor lectus. Aliquam convallis lectus libero. Nulla facilisi. Praesent nec pellentesque magna. Donec accumsan aliquam ultrices. Mauris quis auctor massa, ac eleifend justo. Integer in ante pharetra lectus eleifend posuere.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Sed eleifend eleifend urna, mattis convallis nunc scelerisque eget. Mauris maximus nisl tortor, et facilisis dui hendrerit in. Vestibulum sit amet mollis ligula. Vivamus mattis efficitur efficitur. Donec sed dapibus dui. Proin a mollis neque. Quisque efficitur, risus vitae sodales commodo, arcu dui cursus metus, nec fringilla tortor dui non erat. Aliquam consequat purus sed interdum molestie. Nunc porta bibendum arcu in consectetur.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Lorem ipsum dolor sit amet, conse ctetuer adipiscing elit, sed diam nonum nibhie\n                                    euismod. Facilisis at vero eros et accumsan et iusto odio dignissim qui blandit\n                                    praesent luptatum zzril. Donec ultrices enim lectus, nec volutpat lorem scelerisque\n                                    eu. Cras vitae imperdiet arcu. Duis posuere nunc a nisl condimentum luctus elenit\n                                    augue duis dolore.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab6\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 5\">\n                        <div class=\"row\">\n                            <div class=\"col-md-12\">\n                                <p class=\"mbr-text pt-3 mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Sit quas assum id. Ut oporteat senserit eum. Lucilius electram quo id, vidit virtute\n                                    habemus te mea. Qui sumo assueverit eu. Per utinam ridens volutpat an, cum discere\n                                    mandamus ut, pro in semper prompta omnesque. At pri quando ridens nostrum, labore\n                                    maiorum democritum an pri. In his dolor nullam, ut usu meliore fabellas, nam meliore\n                                    nostrum at. Has facete vivendum cu, ea malorum maiestatis ius. Sed fugit quaestio\n                                    ei. Mazim consulatu consectetuer pri ea, no eius sapientem laboramus vix. Mel an\n                                    conceptam adversarium, civibus splendide scriptorem nec ea.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>","_cid":"sAMCt49VcE","_anchor":"about-us","_PHPplaceholders":[],"_JSplaceholders":[],"_protectedParams":[],"_global":false,"_once":false,"_params":{}},{"alias":false,"_styles":{"padding-top":"(@paddingTop * 15px)","padding-bottom":"(@paddingBottom * 15px)","& when (@bg-type = \"color\")":{"background-color":"@bg-value"},"& when (@bg-type = \"image\")":{"background-image":"url(@bg-value)"},".container-fluid":{"overflow":"hidden"},".carousel-controls":{"display":"none","a":{"transition":"opacity 0.5s","&:hover, &:focus":{"span":{"opacity":"1"},"svg":{"transition":"all 0.25s","stroke-width":"3"}},"&:active":{"svg":{"transition":"all 0.1s","stroke-width":"5"}}}},".carousel-indicators li":{"bottom":"0","width":"15px","height":"15px","margin":"3px","background":"@dotColor1","border":"0","border-radius":"50%","opacity":"0.5"},".carousel-indicators":{"bottom":"0px"},".carousel-indicators .active":{"border":"0px solid #1b1b1b","background":"@dotColor2"},"ol":{"margin-bottom":"0rem"},".carousel-item":{"-webkit-justify-content":"center","justify-content":"center","padding-bottom":"30px","padding-top":"1rem"},".carousel-control-prev":{"-webkit-justify-content":"flex-end","justify-content":"flex-end","-webkit-align-items":"flex-end","align-items":"flex-end","opacity":"0.3"},".carousel-control-next":{"-webkit-justify-content":"flex-start","justify-content":"flex-start","-webkit-align-items":"flex-end","align-items":"flex-end","opacity":"0.3"},".carousel-item.active, .carousel-item-next, .carousel-item-prev":{"display":"flex"},".user_image":{"overflow":"hidden","display":"flex","padding":"1.5rem",".user_image_inner":{"max-width":"250px","max-height":"250px","border-radius":"10%","box-shadow":"0px 0px 30px 0px rgba(0, 0, 0, 0.3)","position":"relative","overflow":"hidden","display":"flex","margin":"auto","img":{"width":"100%","min-width":"100%","min-height":"100%","object-fit":"cover","margin":"0"}}},".user_text":{"color":"#767676","position":"relative"},".underline":{"padding-top":"0.5rem","padding-bottom":"0.5rem",".line":{"width":"5rem","height":"3px","background":"linear-gradient(90deg, @primaryColor, @secondaryColor)","display":"inline-block"}},".testimonials-quote":{"svg":{"height":"50px","width":"50px","opacity":"0.2","margin-bottom":"-50px","margin-left":"-25px","fill":"currentColor"}},".user_name":{"color":"#ffffff","text-align":"right"},".carousel-controls svg":{"height":"60px"},"@media (max-width: 576px)":{".carousel-controls":{"display":"none"}},"@media (max-width: 991px)":{".testimonials-quote, .user_text, .user_name, .user_desk":{"text-align":"center !important"},".carousel-controls a span":{"top":"auto","bottom":"0"},".testimonials-quote":{"svg":{"margin-left":"0px"}}},"@media (min-width: 768px)":{".mbr-section-title, .underline":{"padding-left":"3rem","padding-right":"3rem"}},"@media (min-width: 1200px)":{".carousel-control-prev span":{"right":"-1rem"},".carousel-control-next span":{"left":"-1rem"},".user-text":{"padding-right":"2rem"},".carousel-control-prev, .carousel-control-next":{"-webkit-align-items":"center","align-items":"center"}},".user_desk":{"text-align":"right","color":"#ffffff","font-style":"italic","font-weight":"300"},".user_text, .testimonials-quote":{"color":"#ffffff"}},"_name":"extTestimonials17","_sourceTheme":"mobirise4-blocks-theme","_customHTML":"<section class=\"carousel slide testimonials-slider svg-gradient-elements extTestimonials\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\" inline>\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\" inline>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n            <option value=\"9\">9</option>\n            <option value=\"10\" selected>10</option>\n        </select>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"8000\" condition=\"showAutoplay\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Status\" name=\"showDesk\" checked>\n          <header>Colors</header>\n        <input type=\"color\" title=\"Dot 1\" name=\"dotColor1\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dot 2\" name=\"dotColor2\" value=\"#cccccc\">\n         <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"../_images/background6.jpg\" title=\"Image\" selected>\n            <input type=\"color\" value=\"#073b4c\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=9morbKMwCu4\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#0f7699\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container-fluid text-center\">\n\n        <div class=\"carousel slide d-flex\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n              <ol class=\"carousel-indicators\">\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"0\" mbr-if=\"cardsAmount > 0\" class=\"active\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"1\" mbr-if=\"cardsAmount > 1\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"2\" mbr-if=\"cardsAmount > 2\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"3\" mbr-if=\"cardsAmount > 3\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"4\" mbr-if=\"cardsAmount > 4\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"5\" mbr-if=\"cardsAmount > 5\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"6\" mbr-if=\"cardsAmount > 6\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"7\" mbr-if=\"cardsAmount > 7\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"8\" mbr-if=\"cardsAmount > 8\"></li>\n                <li data-target=\"#carouselExampleIndicators\" data-slide-to=\"9\" mbr-if=\"cardsAmount > 9\"></li>\n              </ol>\n           \n                <div class=\"carousel-item\" mbr-if=\"cardsAmount > 0\">\n                    <div class=\"user col-xl-8 col-lg-10\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-8\">\n                                <div class=\"testimonials-quote align-left\">\n                                    <svg class=\"gradient-element\" viewBox=\"0 0 500 500\">\n                                        <g><g>\n                                            <path d=\"M164.45,219.27h-63.954c-7.614,0-14.087-2.664-19.417-7.994c-5.327-5.33-7.994-11.801-7.994-19.417v-9.132    c0-20.177,7.139-37.401,21.416-51.678c14.276-14.272,31.503-21.411,51.678-21.411h18.271c4.948,0,9.229-1.809,12.847-5.424    c3.616-3.617,5.424-7.898,5.424-12.847V54.819c0-4.948-1.809-9.233-5.424-12.85c-3.617-3.612-7.898-5.424-12.847-5.424h-18.271    c-19.797,0-38.684,3.858-56.673,11.563c-17.987,7.71-33.545,18.132-46.68,31.267c-13.134,13.129-23.553,28.688-31.262,46.677    C3.855,144.039,0,162.931,0,182.726v200.991c0,15.235,5.327,28.171,15.986,38.834c10.66,10.657,23.606,15.985,38.832,15.985    h109.639c15.225,0,28.167-5.328,38.828-15.985c10.657-10.663,15.987-23.599,15.987-38.834V274.088    c0-15.232-5.33-28.168-15.994-38.832C192.622,224.6,179.675,219.27,164.45,219.27z\"></path>\n                                            <path d=\"M459.103,235.256c-10.656-10.656-23.599-15.986-38.828-15.986h-63.953c-7.61,0-14.089-2.664-19.41-7.994    c-5.332-5.33-7.994-11.801-7.994-19.417v-9.132c0-20.177,7.139-37.401,21.409-51.678c14.271-14.272,31.497-21.411,51.682-21.411    h18.267c4.949,0,9.233-1.809,12.848-5.424c3.613-3.617,5.428-7.898,5.428-12.847V54.819c0-4.948-1.814-9.233-5.428-12.85    c-3.614-3.612-7.898-5.424-12.848-5.424h-18.267c-19.808,0-38.691,3.858-56.685,11.563c-17.984,7.71-33.537,18.132-46.672,31.267    c-13.135,13.129-23.559,28.688-31.265,46.677c-7.707,17.987-11.567,36.879-11.567,56.674v200.991    c0,15.235,5.332,28.171,15.988,38.834c10.657,10.657,23.6,15.985,38.828,15.985h109.633c15.229,0,28.171-5.328,38.827-15.985    c10.664-10.663,15.985-23.599,15.985-38.834V274.088C475.082,258.855,469.76,245.92,459.103,235.256z\"></path>\n                                        </g></g>\n                                    </svg>\n                                </div>\n                                <div class=\"user_text pt-3 align-left\">\n                                    <p class=\"mbr-fonts-style \" mbr-theme-style=\"display-5\" data-app-selector=\".user_text,.testimonials-quote\">Holds a Ph.D. in Finance from the University of Port-harcourt (2014) after obtaining an MBA in Finance from the Abubakar Tafewa Balewa University in 2001and a B.Sc. degree in Management Studies from the Usman Danfodio University, Sokoto in 1986. He worked in Afcott Nigeria PLC from 1988 to 1999 where he moved from a trainee Accountant to Assist Manager (account). He joined the Igbenedion University Okada in 2002 as Lecturer II where he rose to the post of a Senior Lecturer. He is a Fellow Of the Chattered Institute of Bankers. Aguwamba is the Executive Director Operations of the Company.&nbsp;<br></p>\n                                </div>\n                                <div mbr-text class=\"user_name mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".user_name\">S M Aguwamba Bsc, Msc, Phd, FCIB</div>\n                                <div mbr-text class=\"user_desk mbr-light mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Director</div>\n                            </div>\n                                 <div class=\"user_image col-lg-4\">\n                                <div class=\"user_image_inner\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/mbr-500x333.webp\" alt>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                \n               <div class=\"carousel-item\" mbr-if=\"cardsAmount > 1\">\n                    <div class=\"user col-xl-8 col-lg-10\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-8\">\n                                <div class=\"testimonials-quote align-left\">\n                                    <svg class=\"gradient-element\" viewBox=\"0 0 500 500\">\n                                        <g><g>\n                                            <path d=\"M164.45,219.27h-63.954c-7.614,0-14.087-2.664-19.417-7.994c-5.327-5.33-7.994-11.801-7.994-19.417v-9.132    c0-20.177,7.139-37.401,21.416-51.678c14.276-14.272,31.503-21.411,51.678-21.411h18.271c4.948,0,9.229-1.809,12.847-5.424    c3.616-3.617,5.424-7.898,5.424-12.847V54.819c0-4.948-1.809-9.233-5.424-12.85c-3.617-3.612-7.898-5.424-12.847-5.424h-18.271    c-19.797,0-38.684,3.858-56.673,11.563c-17.987,7.71-33.545,18.132-46.68,31.267c-13.134,13.129-23.553,28.688-31.262,46.677    C3.855,144.039,0,162.931,0,182.726v200.991c0,15.235,5.327,28.171,15.986,38.834c10.66,10.657,23.606,15.985,38.832,15.985    h109.639c15.225,0,28.167-5.328,38.828-15.985c10.657-10.663,15.987-23.599,15.987-38.834V274.088    c0-15.232-5.33-28.168-15.994-38.832C192.622,224.6,179.675,219.27,164.45,219.27z\"></path>\n                                            <path d=\"M459.103,235.256c-10.656-10.656-23.599-15.986-38.828-15.986h-63.953c-7.61,0-14.089-2.664-19.41-7.994    c-5.332-5.33-7.994-11.801-7.994-19.417v-9.132c0-20.177,7.139-37.401,21.409-51.678c14.271-14.272,31.497-21.411,51.682-21.411    h18.267c4.949,0,9.233-1.809,12.848-5.424c3.613-3.617,5.428-7.898,5.428-12.847V54.819c0-4.948-1.814-9.233-5.428-12.85    c-3.614-3.612-7.898-5.424-12.848-5.424h-18.267c-19.808,0-38.691,3.858-56.685,11.563c-17.984,7.71-33.537,18.132-46.672,31.267    c-13.135,13.129-23.559,28.688-31.265,46.677c-7.707,17.987-11.567,36.879-11.567,56.674v200.991    c0,15.235,5.332,28.171,15.988,38.834c10.657,10.657,23.6,15.985,38.828,15.985h109.633c15.229,0,28.171-5.328,38.827-15.985    c10.664-10.663,15.985-23.599,15.985-38.834V274.088C475.082,258.855,469.76,245.92,459.103,235.256z\"></path>\n                                        </g></g>\n                                    </svg>\n                                </div>\n                                <div class=\"user_text pt-3 align-left\">\n                                    <p class=\"mbr-fonts-style \" mbr-theme-style=\"display-5\" data-app-selector=\".user_text,.testimonials-quote\">Josephine is a season administrator, she joined the  Nigerian Postal Service in 1990 and rose to a senior supervisor, when she left for Serve Oil Nigerian Limited in 2007 after 17 years of service. Her experience and excellent team work capabilities as an executive director of Serve Oil has been of great resource to Serve oil performance rating amongst the Oil and pipeline servicing industry. She join the Company in 2014 as a director.&nbsp;<br></p>\n                                </div>\n                                <div mbr-text class=\"user_name mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".user_name\">Mrs. Josephine Moses Akwaowo</div>\n                                <div mbr-text class=\"user_desk mbr-light mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Director</div>\n                            </div>\n                                 <div class=\"user_image col-lg-4\">\n                                <div class=\"user_image_inner\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/mbr-500x333.webp\" alt>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            \n            \n            \n            \n               <div class=\"carousel-item\" mbr-if=\"cardsAmount > 2\">\n                    <div class=\"user col-xl-8 col-lg-10\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-8\">\n                                <div class=\"testimonials-quote align-left\">\n                                    <svg class=\"gradient-element\" viewBox=\"0 0 500 500\">\n                                        <g><g>\n                                            <path d=\"M164.45,219.27h-63.954c-7.614,0-14.087-2.664-19.417-7.994c-5.327-5.33-7.994-11.801-7.994-19.417v-9.132    c0-20.177,7.139-37.401,21.416-51.678c14.276-14.272,31.503-21.411,51.678-21.411h18.271c4.948,0,9.229-1.809,12.847-5.424    c3.616-3.617,5.424-7.898,5.424-12.847V54.819c0-4.948-1.809-9.233-5.424-12.85c-3.617-3.612-7.898-5.424-12.847-5.424h-18.271    c-19.797,0-38.684,3.858-56.673,11.563c-17.987,7.71-33.545,18.132-46.68,31.267c-13.134,13.129-23.553,28.688-31.262,46.677    C3.855,144.039,0,162.931,0,182.726v200.991c0,15.235,5.327,28.171,15.986,38.834c10.66,10.657,23.606,15.985,38.832,15.985    h109.639c15.225,0,28.167-5.328,38.828-15.985c10.657-10.663,15.987-23.599,15.987-38.834V274.088    c0-15.232-5.33-28.168-15.994-38.832C192.622,224.6,179.675,219.27,164.45,219.27z\"></path>\n                                            <path d=\"M459.103,235.256c-10.656-10.656-23.599-15.986-38.828-15.986h-63.953c-7.61,0-14.089-2.664-19.41-7.994    c-5.332-5.33-7.994-11.801-7.994-19.417v-9.132c0-20.177,7.139-37.401,21.409-51.678c14.271-14.272,31.497-21.411,51.682-21.411    h18.267c4.949,0,9.233-1.809,12.848-5.424c3.613-3.617,5.428-7.898,5.428-12.847V54.819c0-4.948-1.814-9.233-5.428-12.85    c-3.614-3.612-7.898-5.424-12.848-5.424h-18.267c-19.808,0-38.691,3.858-56.685,11.563c-17.984,7.71-33.537,18.132-46.672,31.267    c-13.135,13.129-23.559,28.688-31.265,46.677c-7.707,17.987-11.567,36.879-11.567,56.674v200.991    c0,15.235,5.332,28.171,15.988,38.834c10.657,10.657,23.6,15.985,38.828,15.985h109.633c15.229,0,28.171-5.328,38.827-15.985    c10.664-10.663,15.985-23.599,15.985-38.834V274.088C475.082,258.855,469.76,245.92,459.103,235.256z\"></path>\n                                        </g></g>\n                                    </svg>\n                                </div>\n                                <div class=\"user_text pt-3 align-left\">\n                                    <p class=\"mbr-fonts-style \" mbr-theme-style=\"display-5\" data-app-selector=\".user_text,.testimonials-quote\">Anthony Ekong is an industry technocrat armed with a multidiscipline training exposure that cuts across Architecture, Engineering and the latest of which he bagged an upper class degree in ; Actuarial Science &amp; Finance, from Igbenedion University Okada Edo State, 2005.\n<br>After a stint in teaching, he Started his career as an intern architect with Pendulum Junctions Ventures in  1992 and proceeded to  Mund &amp; Myke Engineering as concept developer (1994-2000) and then  Pension Managers Nig Ltd where he joined as a trainee actuary in 2001 and rose to head the real estate and mortgage department of the organisation in 2007 before assuming his current role as the managing director of Mortgage Konsult Limited in 2010.\n<br>Anthony has demonstrated exceptional proficiency in the designing of financial schemes, worthy of note is the phenomenal Union Homes Savings and Loans’ Pension Linked Mortgage Scheme’s success before it was later discontinued as a result of the enactment 2004 Pension act&nbsp;<br></p>\n                                </div>\n                                <div mbr-text class=\"user_name mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".user_name\">Anthony Ekong</div>\n                                <div mbr-text class=\"user_desk mbr-light mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">CEO</div>\n                            </div>\n                                 <div class=\"user_image col-lg-4\">\n                                <div class=\"user_image_inner\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/mbr-500x333.webp\" alt>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            \n            \n            \n            \n             <div class=\"carousel-item\" mbr-if=\"cardsAmount > 3\">\n                    <div class=\"user col-xl-8 col-lg-10\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-8\">\n                                <div class=\"testimonials-quote align-left\">\n                                    <svg class=\"gradient-element\" viewBox=\"0 0 500 500\">\n                                        <g><g>\n                                            <path d=\"M164.45,219.27h-63.954c-7.614,0-14.087-2.664-19.417-7.994c-5.327-5.33-7.994-11.801-7.994-19.417v-9.132    c0-20.177,7.139-37.401,21.416-51.678c14.276-14.272,31.503-21.411,51.678-21.411h18.271c4.948,0,9.229-1.809,12.847-5.424    c3.616-3.617,5.424-7.898,5.424-12.847V54.819c0-4.948-1.809-9.233-5.424-12.85c-3.617-3.612-7.898-5.424-12.847-5.424h-18.271    c-19.797,0-38.684,3.858-56.673,11.563c-17.987,7.71-33.545,18.132-46.68,31.267c-13.134,13.129-23.553,28.688-31.262,46.677    C3.855,144.039,0,162.931,0,182.726v200.991c0,15.235,5.327,28.171,15.986,38.834c10.66,10.657,23.606,15.985,38.832,15.985    h109.639c15.225,0,28.167-5.328,38.828-15.985c10.657-10.663,15.987-23.599,15.987-38.834V274.088    c0-15.232-5.33-28.168-15.994-38.832C192.622,224.6,179.675,219.27,164.45,219.27z\"></path>\n                                            <path d=\"M459.103,235.256c-10.656-10.656-23.599-15.986-38.828-15.986h-63.953c-7.61,0-14.089-2.664-19.41-7.994    c-5.332-5.33-7.994-11.801-7.994-19.417v-9.132c0-20.177,7.139-37.401,21.409-51.678c14.271-14.272,31.497-21.411,51.682-21.411    h18.267c4.949,0,9.233-1.809,12.848-5.424c3.613-3.617,5.428-7.898,5.428-12.847V54.819c0-4.948-1.814-9.233-5.428-12.85    c-3.614-3.612-7.898-5.424-12.848-5.424h-18.267c-19.808,0-38.691,3.858-56.685,11.563c-17.984,7.71-33.537,18.132-46.672,31.267    c-13.135,13.129-23.559,28.688-31.265,46.677c-7.707,17.987-11.567,36.879-11.567,56.674v200.991    c0,15.235,5.332,28.171,15.988,38.834c10.657,10.657,23.6,15.985,38.828,15.985h109.633c15.229,0,28.171-5.328,38.827-15.985    c10.664-10.663,15.985-23.599,15.985-38.834V274.088C475.082,258.855,469.76,245.92,459.103,235.256z\"></path>\n                                        </g></g>\n                                    </svg>\n                                </div>\n                                <div class=\"user_text pt-3 align-left\">\n                                    <p class=\"mbr-fonts-style \" mbr-theme-style=\"display-5\" data-app-selector=\".user_text,.testimonials-quote\">He holds an MBA Finance degree from the University of Nigeria Nsukka(1992). He graduated as best overall student both in his Faculty and his Department. He is a professional manager and full member of the Nigerian Institute of Management (chartered). He also belongs to the Chartered Institute of Stockbrokers.\n<br>\n<br>Chukwudi Nga has taught finance in some Nigeria Universities including Abubakar Tafawa Balewa University (ATBU), Enugu State University of Science and Technology (ESTU) and Igbinedion University, Okada where he resigned as the acting Head of Department of Banking and Finance.\n<br>He has been involved in the development of Mortgage Backed Securities in the Capital Market, and property unitization schemes for cooperatives.&nbsp;<br></p>\n                                </div>\n                                <div mbr-text class=\"user_name mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".user_name\">Mr. Chukwudi Nga Bsc Hons MBA, MNIM,MCIS</div>\n                                <div mbr-text class=\"user_desk mbr-light mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Head Investments</div>\n                            </div>\n                                 <div class=\"user_image col-lg-4\">\n                                <div class=\"user_image_inner\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/mbr-500x333.webp\" alt>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            \n            \n            \n            \n              <div class=\"carousel-item\" mbr-if=\"cardsAmount > 4\">\n                    <div class=\"user col-xl-8 col-lg-10\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-8\">\n                                <div class=\"testimonials-quote align-left\">\n                                    <svg class=\"gradient-element\" viewBox=\"0 0 500 500\">\n                                        <g><g>\n                                            <path d=\"M164.45,219.27h-63.954c-7.614,0-14.087-2.664-19.417-7.994c-5.327-5.33-7.994-11.801-7.994-19.417v-9.132    c0-20.177,7.139-37.401,21.416-51.678c14.276-14.272,31.503-21.411,51.678-21.411h18.271c4.948,0,9.229-1.809,12.847-5.424    c3.616-3.617,5.424-7.898,5.424-12.847V54.819c0-4.948-1.809-9.233-5.424-12.85c-3.617-3.612-7.898-5.424-12.847-5.424h-18.271    c-19.797,0-38.684,3.858-56.673,11.563c-17.987,7.71-33.545,18.132-46.68,31.267c-13.134,13.129-23.553,28.688-31.262,46.677    C3.855,144.039,0,162.931,0,182.726v200.991c0,15.235,5.327,28.171,15.986,38.834c10.66,10.657,23.606,15.985,38.832,15.985    h109.639c15.225,0,28.167-5.328,38.828-15.985c10.657-10.663,15.987-23.599,15.987-38.834V274.088    c0-15.232-5.33-28.168-15.994-38.832C192.622,224.6,179.675,219.27,164.45,219.27z\"></path>\n                                            <path d=\"M459.103,235.256c-10.656-10.656-23.599-15.986-38.828-15.986h-63.953c-7.61,0-14.089-2.664-19.41-7.994    c-5.332-5.33-7.994-11.801-7.994-19.417v-9.132c0-20.177,7.139-37.401,21.409-51.678c14.271-14.272,31.497-21.411,51.682-21.411    h18.267c4.949,0,9.233-1.809,12.848-5.424c3.613-3.617,5.428-7.898,5.428-12.847V54.819c0-4.948-1.814-9.233-5.428-12.85    c-3.614-3.612-7.898-5.424-12.848-5.424h-18.267c-19.808,0-38.691,3.858-56.685,11.563c-17.984,7.71-33.537,18.132-46.672,31.267    c-13.135,13.129-23.559,28.688-31.265,46.677c-7.707,17.987-11.567,36.879-11.567,56.674v200.991    c0,15.235,5.332,28.171,15.988,38.834c10.657,10.657,23.6,15.985,38.828,15.985h109.633c15.229,0,28.171-5.328,38.827-15.985    c10.664-10.663,15.985-23.599,15.985-38.834V274.088C475.082,258.855,469.76,245.92,459.103,235.256z\"></path>\n                                        </g></g>\n                                    </svg>\n                                </div>\n                                <div class=\"user_text pt-3 align-left\">\n                                    <p class=\"mbr-fonts-style \" mbr-theme-style=\"display-5\" data-app-selector=\".user_text,.testimonials-quote\">She is a graduate of Public Administration from the Ambrose Ali University Ekpoma (2010)with 16 years work experience serving through different capacities that has armed her witha versatility of secreterial  and IT skills. This is evident in the expertise she has brought to bear on the company operating and IT infrastructure. Her working antecedents include Denserve Services (1999 – 2001), Pension Managera Nigerian Limited (2001 – 2008) and  IT World (2008 – 2016) before joining Mortgage Konsult Limited.&nbsp;<br></p>\n                                </div>\n                                <div mbr-text class=\"user_name mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".user_name\">Mrs. Esther Ibara Umoh, Bsc</div>\n                                <div mbr-text class=\"user_desk mbr-light mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Head Secretary</div>\n                            </div>\n                                 <div class=\"user_image col-lg-4\">\n                                <div class=\"user_image_inner\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/mbr-500x333.webp\" alt>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            \n            \n            \n            \n            \n                <div class=\"carousel-item\" mbr-if=\"cardsAmount > 5\">\n                    <div class=\"user col-xl-8 col-lg-10\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-8\">\n                                <div class=\"testimonials-quote align-left\">\n                                    <svg class=\"gradient-element\" viewBox=\"0 0 500 500\">\n                                        <g><g>\n                                            <path d=\"M164.45,219.27h-63.954c-7.614,0-14.087-2.664-19.417-7.994c-5.327-5.33-7.994-11.801-7.994-19.417v-9.132    c0-20.177,7.139-37.401,21.416-51.678c14.276-14.272,31.503-21.411,51.678-21.411h18.271c4.948,0,9.229-1.809,12.847-5.424    c3.616-3.617,5.424-7.898,5.424-12.847V54.819c0-4.948-1.809-9.233-5.424-12.85c-3.617-3.612-7.898-5.424-12.847-5.424h-18.271    c-19.797,0-38.684,3.858-56.673,11.563c-17.987,7.71-33.545,18.132-46.68,31.267c-13.134,13.129-23.553,28.688-31.262,46.677    C3.855,144.039,0,162.931,0,182.726v200.991c0,15.235,5.327,28.171,15.986,38.834c10.66,10.657,23.606,15.985,38.832,15.985    h109.639c15.225,0,28.167-5.328,38.828-15.985c10.657-10.663,15.987-23.599,15.987-38.834V274.088    c0-15.232-5.33-28.168-15.994-38.832C192.622,224.6,179.675,219.27,164.45,219.27z\"></path>\n                                            <path d=\"M459.103,235.256c-10.656-10.656-23.599-15.986-38.828-15.986h-63.953c-7.61,0-14.089-2.664-19.41-7.994    c-5.332-5.33-7.994-11.801-7.994-19.417v-9.132c0-20.177,7.139-37.401,21.409-51.678c14.271-14.272,31.497-21.411,51.682-21.411    h18.267c4.949,0,9.233-1.809,12.848-5.424c3.613-3.617,5.428-7.898,5.428-12.847V54.819c0-4.948-1.814-9.233-5.428-12.85    c-3.614-3.612-7.898-5.424-12.848-5.424h-18.267c-19.808,0-38.691,3.858-56.685,11.563c-17.984,7.71-33.537,18.132-46.672,31.267    c-13.135,13.129-23.559,28.688-31.265,46.677c-7.707,17.987-11.567,36.879-11.567,56.674v200.991    c0,15.235,5.332,28.171,15.988,38.834c10.657,10.657,23.6,15.985,38.828,15.985h109.633c15.229,0,28.171-5.328,38.827-15.985    c10.664-10.663,15.985-23.599,15.985-38.834V274.088C475.082,258.855,469.76,245.92,459.103,235.256z\"></path>\n                                        </g></g>\n                                    </svg>\n                                </div>\n                                <div class=\"user_text pt-3 align-left\">\n                                    <p class=\"mbr-fonts-style \" mbr-theme-style=\"display-5\" data-app-selector=\".user_text,.testimonials-quote\">Greg holds a Bachelor’s degree in Economics &amp; Statistics from the University of Benin, with over 15 years working experience in Human Resources Management including planning, directing and coordinating HR activities such as Recruitment , Selection &amp; Placement, Performance Management, Training &amp; Development, Compensation &amp; Reward, Organizational Development &amp; Change Management and Industrial &amp; Employee Relations\n<br>He is a Chartered member of the Chartered Institute of Personnel Management (ACIPM) and also holds a Master’s degree in Business Administration from the University of Calabar and his  working experiences cut across various sectors; Manufacturing, Trading, Retail business, Agro Allied and Mining &amp; Exploration. He also has penchant for consulting, training, counseling, Administration and strategic management.&nbsp;<br></p>\n                                </div>\n                                <div mbr-text class=\"user_name mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".user_name\">Mr. Greg Alalor Bsc, MBA, ACIPM</div>\n                                <div mbr-text class=\"user_desk mbr-light mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">General Manager</div>\n                            </div>\n                                 <div class=\"user_image col-lg-4\">\n                                <div class=\"user_image_inner\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/mbr-500x333.webp\" alt>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            \n            \n            \n            \n               <div class=\"carousel-item\" mbr-if=\"cardsAmount > 6\">\n                    <div class=\"user col-xl-8 col-lg-10\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-8\">\n                                <div class=\"testimonials-quote align-left\">\n                                    <svg class=\"gradient-element\" viewBox=\"0 0 500 500\">\n                                        <g><g>\n                                            <path d=\"M164.45,219.27h-63.954c-7.614,0-14.087-2.664-19.417-7.994c-5.327-5.33-7.994-11.801-7.994-19.417v-9.132    c0-20.177,7.139-37.401,21.416-51.678c14.276-14.272,31.503-21.411,51.678-21.411h18.271c4.948,0,9.229-1.809,12.847-5.424    c3.616-3.617,5.424-7.898,5.424-12.847V54.819c0-4.948-1.809-9.233-5.424-12.85c-3.617-3.612-7.898-5.4